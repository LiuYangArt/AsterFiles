import { VisualStyle } from "visual-style.slint";
import { UiTexts } from "@ui-texts";
import { HighlightSegment, FileRow, GridRow, PositionedGridRow, HistoryRow, BreadcrumbRow, TabRow, SidebarRow, ColumnRow, ContextCommandRow, OperationRow, HomeItemRow, HomeCardRow } from "models.slint";
export { PopupCommandRow, QuickMenuWindow, QuickSubmenuWindow } from "quick-menu.slint";
export { UiTexts, UiTextValues } from "@ui-texts";
export { HighlightSegment, FileRow, GridRow, PositionedGridRow, HistoryRow, BreadcrumbRow, TabRow, SidebarRow, ColumnRow, ContextCommandRow, OperationRow, HomeItemRow, HomeCardRow } from "models.slint";
export { VisualStyle } from "visual-style.slint";
export { OperationWindow } from "operation-window.slint";
export { ConfirmationWindow } from "confirmation-window.slint";
export { NetworkLoginWindow, WebDavLocationWindow, NetworkLocationRenameWindow } from "network-windows.slint";
import { TabBar } from "tab-bar.slint";
import { NavigationBar } from "address-bar.slint";
import { Sidebar } from "sidebar.slint";
import { FileView } from "file-view.slint";
import { SettingsPage } from "settings-page.slint";
import { WindowOverlays } from "window-overlays.slint";

export component AppWindow inherits Window {
    in property <string> accessibility-window-id <=> tab-bar.accessibility-window-id;
    in property <string> accessibility-context <=> overlays.accessibility-context;
    title: "AsterFiles";
    icon: @image-url("../assets/app-icon.png");
    no-frame: true;
    // Windows cannot start an edge resize while maximized. Slint also keeps the last resize
    // direction until the pointer moves, so a click after maximize can still request one.
    // window_drag_recovery posts WM_EXITSIZEMOVE when that request never enters the system loop.
    resize-border-width: root.maximized ? 0px : 14px;
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 820px;
    min-height: 520px;
    background: VisualStyle.window-background;
    changed dark-theme => { VisualStyle.dark-theme = root.dark-theme; }
    // Keep responsive constraints independent of the window's intrinsic size calculation.
    out property <length> layout-width: root.width;
    in property <length> window-width <=> tab-bar.window-width;
    default-font-family: "Segoe UI";

    in property <image> current-location-icon <=> navigation.current-location-icon;
    in property <bool> current-location-is-drive <=> navigation.current-location-is-drive;
    in-out property <string> address-input <=> navigation.address-input;
    in property <bool> address-editing <=> navigation.address-editing;
    in property <bool> search-mode <=> navigation.search-mode;
    in property <bool> search-results-mode <=> navigation.search-results-mode;
    in property <bool> search-depth-enabled <=> navigation.search-depth-enabled;
    in property <bool> search-recursive <=> navigation.search-recursive;
    in property <bool> file-list-quick-search: false;
    in property <string> status-text: "";
    in property <string> error-page-title: "";
    in property <string> error-page-description: "";
    in property <bool> show-request-access: false;
    in property <bool> request-access-is-network: false;
    in property <bool> show-everything-help: false;
    in property <bool> show-start-everything: false;
    in property <[FileRow]> files;
    in property <[GridRow]> grid-rows;
    in property <bool> grouped-grid-enabled: false;
    in property <[PositionedGridRow]> grouped-grid-layout;
    in property <[PositionedGridRow]> grouped-grid-visible-rows;
    in property <float> grouped-grid-extent;
    private property <length> legacy-grid-extent;
    private property <length> legacy-grid-visible-height;
    callback refresh-grouped-grid-viewport();
    in property <[HomeCardRow]> home-quick-access-items;
    in property <[HomeCardRow]> home-drive-items;
    in property <[HomeCardRow]> home-network-locations-items;
    out property <int> home-column-count: max(1, floor((root.home-content-width + 10px) / (264px + 10px)));
    out property <length> home-card-width: 264px;
    in-out property <length> home-content-width: 264px;
    in property <int> grid-column-count: 1;
    in-out property <int> projected-file-tab-id: -1;
    in-out property <int> projected-file-request-id: -1;
    in property <[TabRow]> tabs <=> tab-bar.tabs;
    in property <[HistoryRow]> back-history <=> navigation.back-history;
    in property <[HistoryRow]> forward-history <=> navigation.forward-history;
    in property <[BreadcrumbRow]> breadcrumb-source;
    in property <[BreadcrumbRow]> breadcrumbs <=> navigation.breadcrumbs;
    in property <[BreadcrumbRow]> breadcrumb-overflow <=> navigation.breadcrumb-overflow;
    in property <float> breadcrumb-overflow-x <=> navigation.breadcrumb-overflow-x;
    in property <float> breadcrumb-overflow-width <=> navigation.breadcrumb-overflow-width;
    in property <int> breadcrumb-generation;
    in property <int> breadcrumb-tab-id: -1;
    in property <string> breadcrumb-request-id;
    in property <[SidebarRow]> sidebar-items;
    in property <[ColumnRow]> columns <=> overlays.columns;
    in property <float> insertion-indicator-width: 5;
    in property <color> insertion-indicator-color: #4f6bed;
    in property <[ContextCommandRow]> context-commands;
    in property <[ContextCommandRow]> context-submenu-commands;
    in property <[ContextCommandRow]> context-submenu-parent-commands;
    in-out property <string> context-search: "";
    in-out property <int> context-active-index: -1;
    in-out property <int> context-submenu-active-index: -1;
    in-out property <bool> context-submenu-open: false;
    in-out property <bool> context-submenu-loading: false;
    in-out property <bool> context-submenu-parent-open: false;
    in-out property <length> context-submenu-anchor-y: 0px;
    in-out property <length> context-submenu-parent-anchor-y: 0px;
    in-out property <length> context-menu-content-height: 0px;
    in-out property <length> context-submenu-content-height: 0px;
    in-out property <length> context-submenu-parent-content-height: 0px;
    in-out property <bool> context-shell-loading: false;
    in-out property <int> context-shell-elapsed-ms: 0;
    in property <[OperationRow]> operations;
    in-out property <length> file-viewport-y: 0px;
    private property <length> list-viewport-y: 0px;
    private property <length> grid-viewport-y: 0px;
    in property <int> projected-content-revision: 0;
    private property <int> active-geometry-revision: root.view-mode * 1000003 + root.projected-content-revision + root.layout-icon-size / 1px;
    in-out property <length> search-scroll-y: 0px;
    in property <int> search-total-items: 0;
    in-out property <length> sidebar-viewport-y: 0px;

    out property <length> quick-access-drop-left: 0px;
    out property <length> quick-access-drop-top: 0px;
    out property <length> quick-access-drop-width: 0px;
    out property <length> quick-access-drop-height: 0px;
    out property <length> file-list-left: 0px;
    out property <length> file-list-top <=> overlays.file-list-top;
    out property <length> rectangle-viewport-top: 0px;
    out property <length> file-viewport-width: 0px;
    out property <length> file-viewport-height: 0px;
    in-out property <int> view-mode: 0;
    public pure function is-grid-view-mode(mode: int) -> bool {
        return mode == 2 || mode == 3 || mode == 4 || mode == 5 || mode == 6;
    }
    public pure function is-icon-view-mode(mode: int) -> bool {
        return mode == 2 || mode == 3 || mode == 4 || mode == 5;
    }
    in property <length> layout-row-height: 32px;
    in property <length> layout-card-width: 0px;
    in property <length> layout-icon-size: 32px;
    function sync-active-file-viewport() {
        if root.is-grid-view-mode(root.view-mode) {
            root.grid-viewport-y = root.file-viewport-y;
        } else {
            root.list-viewport-y = root.file-viewport-y;
        }
    }
    changed file-viewport-y => {
        if root.rename-editing && root.is-grid-view-mode(root.view-mode) && root.grid-rename-anchor-id >= 0 {
            root.grid-rename-anchor-id = -1;
            root.cancel-rename();
        }
        root.sync-active-file-viewport();
        if root.grouped-grid-enabled {
            root.refresh-grouped-grid-viewport();
            root.request-folder-size-range(root.file-viewport-y / 1px, root.file-viewport-height / 1px);
        }
    }
    changed file-viewport-height => { if root.grouped-grid-enabled { root.refresh-grouped-grid-viewport(); } }

    out property <bool> file-list-keyboard-target: !root.active-is-settings && !root.active-is-home
    && !root.address-editing
    && !root.rename-editing
    && !root.tabs-menu-open
    && !root.context-menu-open
    && !root.drop-menu-open;
    in-out property <bool> context-menu-open <=> tab-bar.context-menu-open;
    in-out property <bool> drop-menu-open <=> overlays.drop-menu-open;
    in property <bool> drop-can-copy <=> overlays.drop-can-copy;
    in property <bool> drop-can-move <=> overlays.drop-can-move;
    in property <bool> drop-can-link <=> overlays.drop-can-link;
    in-out property <string> rename-input <=> overlays.rename-input;
    in property <int> rename-selection-end <=> overlays.rename-selection-end;
    in property <int> rename-entry-id <=> overlays.rename-entry-id;
    in property <bool> rename-editing <=> overlays.rename-editing;
    in-out property <bool> rename-submitting <=> overlays.rename-submitting;
    in-out property <int> rename-submit-generation <=> overlays.rename-submit-generation;
    private property <length> grid-rename-left <=> overlays.grid-rename-left;
    private property <length> grid-rename-top <=> overlays.grid-rename-top;
    private property <length> grid-rename-width <=> overlays.grid-rename-width;
    private property <length> grid-rename-height <=> overlays.grid-rename-height;
    private property <string> grid-rename-label <=> overlays.grid-rename-label;
    private property <int> grid-rename-anchor-id <=> overlays.grid-rename-anchor-id;
    private property <string> grid-rename-context <=> overlays.grid-rename-context;
    changed rename-editing => { if !root.rename-editing { root.grid-rename-anchor-id = -1; } }
    in property <string> operation-error: "";
    in property <bool> context-menu-has-entry: false;
    in-out property <bool> quick-access-expanded: true;
    in-out property <bool> libraries-expanded: true;
    in-out property <bool> drives-expanded: true;
    in-out property <bool> network-locations-expanded: true;
    in-out property <bool> network-expanded: false;
    in-out property <bool> home-quick-access-expanded: true;
    in-out property <bool> home-drives-expanded: true;
    in-out property <bool> home-network-locations-expanded: true;
    in-out property <string> home-selected-id: "";
    in property <bool> quick-access-visible: true;
    in property <bool> libraries-visible: false;
    in property <bool> drives-visible: true;
    in property <bool> network-locations-visible: true;
    in property <bool> network-visible: true;

    in property <bool> network-discovery-loading: false;
    in property <bool> network-discovery-empty: false;
    in property <string> network-discovery-error: "";

    in property <bool> can-navigate-back <=> navigation.can-navigate-back;
    in property <bool> can-navigate-forward <=> navigation.can-navigate-forward;
    in property <bool> can-navigate-up <=> navigation.can-navigate-up;
    in property <bool> can-refresh <=> navigation.can-refresh;
    in property <bool> can-close-tab <=> tab-bar.can-close-tab;
    in property <bool> can-restore-tab: false;
    in property <int> selected-count: 0;
    in property <int> drop-hover-entry-id: -1;
    in property <int> sort-field: 0;
    in property <bool> sort-descending: false;
    in property <int> page-state: 0;
    in property <bool> loading-hint-visible: false;
    in property <int> loading-hint-generation: 0;
    in property <bool> dark-theme: false;
    in property <int> theme-mode: 0;
    in property <int> language-mode: 0;
    in property <bool> show-hidden-files: true;
    in property <bool> show-system-files: false;
    in property <bool> quick-menu-backdrop: true;
    in property <float> quick-menu-backdrop-opacity: 85;
    in property <bool> active-is-settings <=> navigation.active-is-settings;
    in property <bool> active-is-home <=> navigation.active-is-home;
    in property <bool> new-tab-opens-home: true;
    in property <bool> debug-tools-enabled: false;

    in property <bool> folder-integration-enabled: false;
    in property <bool> folder-integration-needs-repair: false;
    in property <bool> win-e-integration-enabled: false;
    in property <bool> win-e-integration-needs-repair: false;
    in property <bool> system-integration-busy: false;
    in property <string> folder-integration-status: "";
    in property <string> win-e-integration-status: "";
    in property <string> folder-integration-bound-path: "";
    in property <string> win-e-integration-bound-path: "";
    in property <string> app-version: "";
    in-out property <string> everything-path: "";
    in-out property <string> everything-instance: "1.5a";
    in property <string> everything-status: "";
    in property <bool> everything-busy: false;
    in property <bool> window-trace-active: false;
    in property <string> window-trace-status: "";

    callback navigate-path <=> navigation.navigate-path;
    callback address-input-changed <=> navigation.address-input-changed;
    callback request-search-position(float);
    callback request-folder-size-range(float, float);
    callback begin-search <=> navigation.begin-search;
    callback toggle-search-depth <=> navigation.toggle-search-depth;

    callback cancel-address-edit <=> navigation.cancel-address-edit;
    callback navigate-back <=> navigation.navigate-back;
    callback navigate-forward <=> navigation.navigate-forward;
    callback navigate-history <=> navigation.navigate-history;
    callback navigate-up <=> navigation.navigate-up;
    callback refresh <=> navigation.refresh;
    callback request-folder-access();
    callback navigate-home-item(string);
    callback select-home-item(string);
    callback toggle-home-section(int);

    callback navigate-sidebar(int);
    callback navigate-library(string);
    callback navigate-network-location(string);
    callback show-sidebar-menu(int, string, float, float);
    callback show-sidebar-background-menu(float, float);
    callback toggle-network();
    callback refresh-network();
    callback navigate-breadcrumb <=> navigation.navigate-breadcrumb;
    callback select-entry(int, bool, bool);
    callback clear-selection();
    callback begin-rectangle-selection(float, float, bool, bool);
    callback update-rectangle-selection(float, float);
    callback end-rectangle-selection();
    callback cancel-rectangle-selection();
    public function show-rectangle-selection(x: float, y: float, width: float, height: float) {
        root.rectangle-selection-x = x * 1px;
        root.rectangle-selection-y = y * 1px;
        root.rectangle-selection-width = width * 1px;
        root.rectangle-selection-height = height * 1px;
        root.rectangle-selection-visible = true;
    }
    public function clear-rectangle-selection() {
        root.rectangle-selection-pointer-active = false;
        root.rectangle-selection-visible = false;
        root.rectangle-selection-width = 0px;
        root.rectangle-selection-height = 0px;
    }

    callback select-all();
    callback move-focus(int, bool);
    callback focus-boundary(bool, bool);
    callback toggle-focused();
    callback change-sort(int);
    callback change-view-mode(int);
    callback begin-column-drag(int, float, float);
    callback update-column-drag(float, float, float, float, float, float) -> int;
    callback end-column-drag(bool);
    callback cancel-column-drag();
    callback resize-column(int, float);
    callback show-column-menu(int, float, float);
    callback open-entry(int);
    callback activate-entry(int, bool, bool);
    callback arm-internal-drag(float, float);
    callback begin-internal-drag(int);
    callback cancel-internal-drag();
    // Right press arms a drag candidate; the native release opens the entry menu if no drag started.
    callback arm-internal-right-drag(float, float);
    callback begin-internal-right-drag(int, float, float);
    callback release-internal-right-drag();
    // Returns true when the native move started a file drag and must not reach Slint.
    callback update-internal-drag(float, float) -> bool;
    public function release-internal-drag-pointer() {
        root.cancel-internal-drag();
    }
    callback choose-drop-effect <=> overlays.choose-drop-effect;
    public function show-drop-menu(x: float, y: float) {
        root.context-menu-anchor-x = x * 1px;
        root.context-menu-anchor-y = y * 1px;
        root.context-menu-open = false; root.dismiss-context-menu();
        root.context-search = "";
        root.drop-menu-open = true;
    }
    callback new-tab <=> tab-bar.new-tab;
    callback close-tab <=> tab-bar.close-tab;
    callback restore-tab();
    callback activate-tab <=> tab-bar.activate-tab;
    callback begin-tab-drag <=> tab-bar.begin-tab-drag;
    callback update-tab-drag <=> tab-bar.update-tab-drag;
    callback cancel-tab-drag();
    callback open-settings();
    callback change-theme(int);
    callback change-language(int);
    callback change-file-visibility(bool, bool);
    callback change-file-list-quick-search(bool);
    callback change-new-tab-opens-home(bool);
    callback change-quick-menu-backdrop(bool);
    callback change-quick-menu-backdrop-opacity(float);
    callback enable-folder-integration();
    callback repair-folder-integration();
    callback restore-folder-integration();
    callback enable-win-e-integration();
    callback repair-win-e-integration();
    callback restore-win-e-integration();
    callback update-everything-config(string, string);
    callback select-everything-program();
    callback test-everything-connection();
    callback start-everything();
    callback discover-everything();
    callback download-everything();
    callback drag-window <=> tab-bar.drag-window;
    callback drag-window-after-menu-dismiss <=> overlays.drag-window-after-menu-dismiss;
    callback begin-address-drag <=> navigation.begin-address-drag;
    callback update-address-drag <=> navigation.update-address-drag;
    callback end-address-drag <=> navigation.end-address-drag;
    callback show-entry-menu(int, float, float);

    callback show-background-menu(float, float);
    callback reopen-context-menu(float, float);
    callback invoke-context-command(int);
    callback filter-context-menu(string);
    callback move-context-selection(int);
    callback move-context-submenu-selection(int);
    callback activate-context-selection();
    callback activate-context-submenu-selection();
    callback open-context-submenu(int);
    callback hover-context-submenu(int);
    callback cancel-context-submenu-hover();
    callback close-context-submenu();
    callback dismiss-context-menu <=> tab-bar.dismiss-context-menu;
    callback copy-selection(bool);
    callback request-undo();
    callback paste-files();
    callback begin-rename();
    callback commit-rename <=> overlays.commit-rename;
    callback cancel-rename <=> overlays.cancel-rename;
    callback request-delete(bool);
    callback cancel-operation(int);
    callback retry-operation(int);
    callback open-operation-window();
    callback request-close <=> tab-bar.request-close;
    callback show-debug-window(int);
    callback start-window-trace();

    private property <bool> compact: root.window-width < 1000px;
    in-out property <bool> rectangle-selection-visible: false;
    in-out property <bool> rectangle-selection-pointer-active: false;
    private property <length> rectangle-selection-x: 0px;
    private property <length> rectangle-selection-y: 0px;
    private property <length> rectangle-selection-width: 0px;
    private property <length> rectangle-selection-height: 0px;
    in-out property <bool> scrollbar-pointer-active: false;
    in-out property <length> file-viewport-x: 0px;
    in-out property <length> normal-name-width: 480px;
    in-out property <length> normal-kind-width: 160px;
    in-out property <length> normal-size-width: 120px;
    in-out property <length> normal-modified-width: 200px;
    in-out property <length> normal-created-width: 200px;
    in-out property <length> search-name-width: 400px;
    in-out property <length> search-parent-width: 320px;
    in-out property <length> search-size-width: 120px;
    in-out property <length> search-modified-width: 200px;
    in-out property <length> search-created-width: 200px;
    private property <length> file-columns-width:
        root.visible-column-width(0) + root.visible-column-width(1) + root.visible-column-width(2) + root.visible-column-width(3) + root.visible-column-width(4);
    out property <length> details-hit-left: 16px + root.file-viewport-x;
    out property <length> details-hit-width: root.file-columns-width;
    out property <length> details-hit-visible-left: max(16px, root.details-hit-left);
    out property <length> details-hit-visible-right: min(root.file-viewport-width, root.details-hit-left + root.details-hit-width);
    private property <length> header-available-width: max(0px, root.width - (root.minimal ? 0px : (root.compact ? 184px : 218px)) - 44px);
    changed header-available-width => { root.clamp-file-viewport(root.header-available-width); }
    changed search-results-mode => { root.file-viewport-x = 0px; }
    function column-width(kind: int) -> length {
        return root.search-results-mode
        ? (kind == 0 ? root.search-name-width : kind == 1 ? root.search-parent-width : kind == 2 ? root.search-size-width : kind == 3 ? root.search-modified-width : root.search-created-width)
        : (kind == 0 ? root.normal-name-width : kind == 1 ? root.normal-kind-width : kind == 2 ? root.normal-size-width : kind == 3 ? root.normal-modified-width : root.normal-created-width);
    }
    function visible-column-width(index: int) -> length {
        return root.columns[index].visible ? root.column-width(root.columns[index].kind) : 0px;
    }

    function clamp-file-viewport(available: length) {
        root.file-viewport-x = max(min(0px, available - root.file-columns-width), min(0px, root.file-viewport-x));
    }

    in-out property <length> context-menu-anchor-x <=> overlays.context-menu-anchor-x;
    in-out property <length> context-menu-anchor-y <=> overlays.context-menu-anchor-y;
    private property <length> keyboard-menu-anchor-x: 24px;
    private property <length> keyboard-menu-anchor-y: 140px;
    private property <int> settings-section: 0;
    private property <bool> minimal: root.window-width < 900px;
    in-out property <bool> column-dragging <=> overlays.column-dragging;
    private property <bool> column-drag-pointer-active: false;
    private property <int> column-drag-source-kind <=> overlays.column-drag-source-kind;
    private property <int> column-drag-insertion-slot: -1;
    private property <bool> suppress-column-click: false;
    private property <length> column-drag-pointer-x <=> overlays.column-drag-pointer-x;
    private property <length> column-drag-pointer-y <=> overlays.column-drag-pointer-y;
    public function clear-column-drag() {
        root.column-dragging = false;
        root.column-drag-pointer-active = false;
        root.column-drag-source-kind = -1;
        root.column-drag-insertion-slot = -1;
    }
    public function cancel-column-drag-from-window() {
        root.suppress-column-click = root.column-dragging;
        root.cancel-column-drag();
    }
    public function has-column-drag() -> bool { return root.column-drag-pointer-active; }

    in property <int> active-tab-index <=> tab-bar.active-tab-index;

    callback dismiss-address-edit <=> navigation.dismiss-address-edit;
    in-out property <bool> sidebar-keyboard-active: false;
    in-out property <int> sidebar-keyboard-group: -1;
    in-out property <string> sidebar-keyboard-stable-id: "";
    in-out property <float> sidebar-keyboard-anchor-x: 0;
    in-out property <float> sidebar-keyboard-anchor-y: 0;
    public function show-keyboard-context-menu() {
        if root.sidebar-keyboard-active && root.sidebar-keyboard-stable-id != "" {
            root.show-sidebar-menu(root.sidebar-keyboard-group, root.sidebar-keyboard-stable-id, root.sidebar-keyboard-anchor-x, root.sidebar-keyboard-anchor-y);
            return;
        }
        root.context-menu-anchor-x = root.keyboard-menu-anchor-x;
        root.context-menu-anchor-y = root.keyboard-menu-anchor-y;
        if root.context-menu-has-entry {
            root.show-entry-menu(
                -1,
                root.context-menu-anchor-x / 1px,
                root.context-menu-anchor-y / 1px
            );
        } else {
            root.show-background-menu(
                root.context-menu-anchor-x / 1px,
                root.context-menu-anchor-y / 1px
            );
        }
    }
    public function context-menu-x() -> float { return root.context-menu-anchor-x / 1px; }
    public function context-menu-y() -> float { return root.context-menu-anchor-y / 1px; }

    out property <length> tab-current-width <=> tab-bar.tab-current-width;
    out property <length> tab-strip-width <=> tab-bar.tab-strip-width;
    out property <length> tab-viewport-x <=> tab-bar.tab-viewport-x;
    in-out property <bool> tab-dragging <=> tab-bar.tab-dragging;
    in-out property <bool> suppress-tab-click <=> tab-bar.suppress-tab-click;
    out property <float> breadcrumb-available-width <=> navigation.breadcrumb-available-width;
    private property <bool> tabs-overflow <=> tab-bar.tabs-overflow;
    private property <bool> tabs-menu-open <=> tab-bar.tabs-menu-open;
    public function clear-tab-drag() { tab-bar.clear-tab-drag(); }
    public function release-tab-drag-pointer() { tab-bar.release-tab-drag-pointer(); }
    public function focus-address-editor() { navigation.focus-address-editor(); }
    public function dismiss-address-edit-outside(x: float, y: float) { navigation.dismiss-address-edit-outside(x, y); }
    public function measure-breadcrumb(label: string, current: bool) -> float { return navigation.measure-breadcrumb(label, current); }
    public function close-breadcrumb-menu() { navigation.close-breadcrumb-menu(); }
    callback breadcrumb-width-changed <=> navigation.breadcrumb-width-changed;
    forward-focus: shortcut-handler;
    shortcut-handler := FocusScope {
        width: parent.width;
        height: parent.height;
        KeyBinding { keys: @keys(Alt + LeftArrow); enabled: root.can-navigate-back; activated => { root.navigate-back(); } }
        KeyBinding { keys: @keys(Alt + RightArrow); enabled: root.can-navigate-forward; activated => { root.navigate-forward(); } }
        KeyBinding { keys: @keys(Alt + UpArrow); enabled: root.can-navigate-up; activated => { root.navigate-up(); } }
        KeyBinding { keys: @keys(F5); enabled: root.can-refresh; activated => { root.refresh(); } }
        KeyBinding { keys: @keys(Control + R); enabled: root.can-refresh; activated => { root.refresh(); } }
        KeyBinding { keys: @keys(Control + L); enabled: !root.active-is-settings; activated => { root.begin-search(); } }
        KeyBinding { keys: @keys(Alt + D); enabled: !root.active-is-settings; activated => { root.begin-search(); } }
        KeyBinding { keys: @keys(Control + A); enabled: !root.active-is-settings && !root.active-is-home && !root.address-editing; activated => { root.select-all(); } }
        KeyBinding { keys: @keys(Control + Space); enabled: !root.active-is-settings && !root.active-is-home && !root.address-editing; activated => { root.toggle-focused(); } }
        KeyBinding { keys: @keys(UpArrow); enabled: !root.active-is-settings && !root.active-is-home && !root.address-editing; activated => { root.move-focus(-1, false); } }
        KeyBinding { keys: @keys(DownArrow); enabled: !root.active-is-settings && !root.active-is-home && !root.address-editing; activated => { root.move-focus(1, false); } }
        KeyBinding { keys: @keys(Shift + UpArrow); enabled: !root.active-is-settings && !root.active-is-home && !root.address-editing; activated => { root.move-focus(-1, true); } }
        KeyBinding { keys: @keys(Shift + DownArrow); enabled: !root.active-is-settings && !root.active-is-home && !root.address-editing; activated => { root.move-focus(1, true); } }
        KeyBinding { keys: @keys(Home); enabled: !root.active-is-settings && !root.active-is-home && !root.address-editing; activated => { root.focus-boundary(false, false); } }
        KeyBinding { keys: @keys(End); enabled: !root.active-is-settings && !root.active-is-home && !root.address-editing; activated => { root.focus-boundary(true, false); } }
        KeyBinding { keys: @keys(Shift + Home); enabled: !root.active-is-settings && !root.active-is-home && !root.address-editing; activated => { root.focus-boundary(false, true); } }
        KeyBinding { keys: @keys(Shift + End); enabled: !root.active-is-settings && !root.active-is-home && !root.address-editing; activated => { root.focus-boundary(true, true); } }
        KeyBinding { keys: @keys(Return); enabled: !root.active-is-settings && !root.active-is-home && !root.address-editing; activated => { root.open-entry(-1); } }
        KeyBinding { keys: @keys(Control + Z); enabled: root.file-list-keyboard-target; activated => { root.request-undo(); } }
        KeyBinding { keys: @keys(Control + C); enabled: !root.active-is-settings && !root.active-is-home && !root.address-editing; activated => { root.copy-selection(false); } }
        KeyBinding { keys: @keys(Control + X); enabled: !root.active-is-settings && !root.active-is-home && !root.address-editing; activated => { root.copy-selection(true); } }
        KeyBinding { keys: @keys(Control + V); enabled: !root.active-is-settings && !root.active-is-home && !root.address-editing; activated => { root.paste-files(); } }
        KeyBinding { keys: @keys(F2); enabled: !root.active-is-settings && !root.active-is-home && !root.address-editing; activated => { root.begin-rename(); } }
        KeyBinding { keys: @keys(Delete); enabled: !root.active-is-settings && !root.active-is-home && !root.address-editing; activated => { root.request-delete(false); } }
        KeyBinding { keys: @keys(Shift + Delete); enabled: !root.active-is-settings && !root.active-is-home && !root.address-editing; activated => { root.request-delete(true); } }
        KeyBinding {
            keys: @keys(Shift + F10);
            enabled: !root.active-is-settings && !root.active-is-home && !root.address-editing;
            activated => { root.show-keyboard-context-menu(); }
        }

        VerticalLayout {
            spacing: 0px;
            tab-bar := TabBar {
                window-maximized <=> root.maximized;
                window-minimized <=> root.minimized;
            }

            navigation := NavigationBar {
                compact: root.compact;
                minimal: root.minimal;
                window-origin: root.absolute-position;
            }

            if !root.active-is-settings: HorizontalLayout {
                spacing: 0px;
                if !root.minimal: sidebar := Sidebar {
                    compact: root.compact;
                    context-menu-anchor-x <=> root.context-menu-anchor-x;
                    context-menu-anchor-y <=> root.context-menu-anchor-y;
                    drives-expanded <=> root.drives-expanded;
                    drives-visible: root.drives-visible;
                    libraries-expanded <=> root.libraries-expanded;
                    libraries-visible: root.libraries-visible;
                    navigate-library(p0) => { root.navigate-library(p0); }
                    navigate-network-location(p0) => { root.navigate-network-location(p0); }
                    navigate-sidebar(p0) => { root.navigate-sidebar(p0); }
                    network-discovery-empty: root.network-discovery-empty;
                    network-discovery-error: root.network-discovery-error;
                    network-discovery-loading: root.network-discovery-loading;
                    network-expanded <=> root.network-expanded;
                    network-locations-expanded <=> root.network-locations-expanded;
                    network-locations-visible: root.network-locations-visible;
                    network-visible: root.network-visible;
                    open-settings() => { root.open-settings(); }
                    quick-access-drop-height <=> root.quick-access-drop-height;
                    quick-access-drop-left <=> root.quick-access-drop-left;
                    quick-access-drop-top <=> root.quick-access-drop-top;
                    quick-access-drop-width <=> root.quick-access-drop-width;
                    quick-access-expanded <=> root.quick-access-expanded;
                    quick-access-visible: root.quick-access-visible;
                    refresh-network() => { root.refresh-network(); }
                    show-sidebar-background-menu(p0, p1) => { root.show-sidebar-background-menu(p0, p1); }
                    show-sidebar-menu(p0, p1, p2, p3) => { root.show-sidebar-menu(p0, p1, p2, p3); }
                    sidebar-items: root.sidebar-items;
                    sidebar-keyboard-active <=> root.sidebar-keyboard-active;
                    sidebar-keyboard-anchor-x <=> root.sidebar-keyboard-anchor-x;
                    sidebar-keyboard-anchor-y <=> root.sidebar-keyboard-anchor-y;
                    sidebar-keyboard-group <=> root.sidebar-keyboard-group;
                    sidebar-keyboard-stable-id <=> root.sidebar-keyboard-stable-id;
                    sidebar-viewport-y <=> root.sidebar-viewport-y;
                    toggle-network() => { root.toggle-network(); }
                    window-origin: root.absolute-position;
                }

                file-view := FileView {
                    accessibility-context: root.accessibility-context;
                    activate-entry(p0, p1, p2) => { root.activate-entry(p0, p1, p2); }
                    active-geometry-revision: root.active-geometry-revision;
                    active-is-home: root.active-is-home;
                    begin-column-drag(p0, p1, p2) => { root.begin-column-drag(p0, p1, p2); }
                    begin-internal-drag(p0) => { root.begin-internal-drag(p0); }
                    begin-internal-right-drag(p0, p1, p2) => { root.begin-internal-right-drag(p0, p1, p2); }
                    begin-rectangle-selection(p0, p1, p2, p3) => { root.begin-rectangle-selection(p0, p1, p2, p3); }
                    cancel-internal-drag() => { root.cancel-internal-drag(); }
                    cancel-rename() => { root.cancel-rename(); }
                    change-sort(p0) => { root.change-sort(p0); }
                    change-view-mode(p0) => { root.change-view-mode(p0); }
                    column-drag-insertion-slot <=> root.column-drag-insertion-slot;
                    column-drag-pointer-active <=> root.column-drag-pointer-active;
                    column-drag-pointer-x <=> root.column-drag-pointer-x;
                    column-drag-pointer-y <=> root.column-drag-pointer-y;
                    column-drag-source-kind <=> root.column-drag-source-kind;
                    column-dragging <=> root.column-dragging;
                    columns: root.columns;
                    commit-rename(p0) => { root.commit-rename(p0); }
                    context-menu-anchor-x <=> root.context-menu-anchor-x;
                    context-menu-anchor-y <=> root.context-menu-anchor-y;
                    details-hit-left: root.details-hit-left;
                    details-hit-visible-left: root.details-hit-visible-left;
                    details-hit-visible-right: root.details-hit-visible-right;
                    download-everything() => { root.download-everything(); }
                    drop-hover-entry-id: root.drop-hover-entry-id;
                    end-column-drag(p0) => { root.end-column-drag(p0); }
                    end-rectangle-selection() => { root.end-rectangle-selection(); }
                    error-page-description: root.error-page-description;
                    error-page-title: root.error-page-title;
                    file-columns-width: root.file-columns-width;
                    file-list-left <=> root.file-list-left;
                    file-list-top <=> root.file-list-top;
                    file-viewport-height <=> root.file-viewport-height;
                    file-viewport-width <=> root.file-viewport-width;
                    file-viewport-x <=> root.file-viewport-x;
                    file-viewport-y <=> root.file-viewport-y;
                    files: root.files;
                    grid-column-count: root.grid-column-count;
                    grid-rename-anchor-id <=> root.grid-rename-anchor-id;
                    grid-rename-context <=> root.grid-rename-context;
                    grid-rename-height <=> root.grid-rename-height;
                    grid-rename-label <=> root.grid-rename-label;
                    grid-rename-left <=> root.grid-rename-left;
                    grid-rename-top <=> root.grid-rename-top;
                    grid-rename-width <=> root.grid-rename-width;
                    grid-rows: root.grid-rows;
                    grid-viewport-y <=> root.grid-viewport-y;
                    grouped-grid-enabled: root.grouped-grid-enabled;
                    grouped-grid-extent: root.grouped-grid-extent;
                    grouped-grid-visible-rows: root.grouped-grid-visible-rows;
                    home-card-width: root.home-card-width;
                    home-column-count: root.home-column-count;
                    home-drive-items: root.home-drive-items;
                    home-drives-expanded: root.home-drives-expanded;
                    home-network-locations-expanded: root.home-network-locations-expanded;
                    home-network-locations-items: root.home-network-locations-items;
                    home-quick-access-expanded: root.home-quick-access-expanded;
                    home-quick-access-items: root.home-quick-access-items;
                    home-selected-id <=> root.home-selected-id;
                    insertion-indicator-color: root.insertion-indicator-color;
                    insertion-indicator-width: root.insertion-indicator-width;
                    keyboard-menu-anchor-x <=> root.keyboard-menu-anchor-x;
                    keyboard-menu-anchor-y <=> root.keyboard-menu-anchor-y;
                    layout-card-width: root.layout-card-width;
                    layout-icon-size: root.layout-icon-size;
                    layout-row-height: root.layout-row-height;
                    legacy-grid-extent <=> root.legacy-grid-extent;
                    legacy-grid-visible-height <=> root.legacy-grid-visible-height;
                    list-viewport-y <=> root.list-viewport-y;
                    loading-hint-visible: root.loading-hint-visible;
                    minimal: root.minimal;
                    navigate-home-item(p0) => { root.navigate-home-item(p0); }
                    normal-created-width <=> root.normal-created-width;
                    normal-kind-width <=> root.normal-kind-width;
                    normal-modified-width <=> root.normal-modified-width;
                    normal-name-width <=> root.normal-name-width;
                    normal-size-width <=> root.normal-size-width;
                    open-operation-window() => { root.open-operation-window(); }
                    open-settings() => { root.open-settings(); }
                    operation-error: root.operation-error;
                    operations: root.operations;
                    page-state: root.page-state;
                    rectangle-selection-height: root.rectangle-selection-height;
                    rectangle-selection-pointer-active <=> root.rectangle-selection-pointer-active;
                    rectangle-selection-visible: root.rectangle-selection-visible;
                    rectangle-selection-width: root.rectangle-selection-width;
                    rectangle-selection-x: root.rectangle-selection-x;
                    rectangle-selection-y: root.rectangle-selection-y;
                    rectangle-viewport-top <=> root.rectangle-viewport-top;
                    rename-editing: root.rename-editing;
                    rename-entry-id: root.rename-entry-id;
                    rename-input <=> root.rename-input;
                    rename-selection-end: root.rename-selection-end;
                    rename-submit-generation: root.rename-submit-generation;
                    rename-submitting <=> root.rename-submitting;
                    request-folder-access() => { root.request-folder-access(); }
                    request-folder-size-range(p0, p1) => { root.request-folder-size-range(p0, p1); }
                    request-search-position(p0) => { root.request-search-position(p0); }
                    resize-column(p0, p1) => { root.resize-column(p0, p1); }
                    scrollbar-pointer-active <=> root.scrollbar-pointer-active;
                    search-created-width <=> root.search-created-width;
                    search-modified-width <=> root.search-modified-width;
                    search-name-width <=> root.search-name-width;
                    search-parent-width <=> root.search-parent-width;
                    search-results-mode: root.search-results-mode;
                    search-scroll-y: root.search-scroll-y;
                    search-size-width <=> root.search-size-width;
                    search-total-items: root.search-total-items;
                    select-home-item(p0) => { root.select-home-item(p0); }
                    settings-section <=> root.settings-section;
                    show-background-menu(p0, p1) => { root.show-background-menu(p0, p1); }
                    show-column-menu(p0, p1, p2) => { root.show-column-menu(p0, p1, p2); }
                    show-everything-help: root.show-everything-help;
                    show-request-access: root.show-request-access;
                    request-access-is-network: root.request-access-is-network;
                    show-sidebar-menu(p0, p1, p2, p3) => { root.show-sidebar-menu(p0, p1, p2, p3); }
                    show-start-everything: root.show-start-everything;
                    sort-descending: root.sort-descending;
                    sort-field: root.sort-field;
                    start-everything() => { root.start-everything(); }
                    status-text: root.status-text;
                    suppress-column-click <=> root.suppress-column-click;
                    toggle-home-section(p0) => { root.toggle-home-section(p0); }
                    update-column-drag(p0, p1, p2, p3, p4, p5) => { return root.update-column-drag(p0, p1, p2, p3, p4, p5); }
                    update-rectangle-selection(p0, p1) => { root.update-rectangle-selection(p0, p1); }
                    view-mode: root.view-mode;
                    window-actual-width: root.width;
                    window-origin: root.absolute-position;
                }
            }

            if root.active-is-settings: settings-page := SettingsPage {
                app-version: root.app-version;
                change-file-list-quick-search(p0) => { root.change-file-list-quick-search(p0); }
                change-file-visibility(p0, p1) => { root.change-file-visibility(p0, p1); }
                change-language(p0) => { root.change-language(p0); }
                change-new-tab-opens-home(p0) => { root.change-new-tab-opens-home(p0); }
                change-quick-menu-backdrop(p0) => { root.change-quick-menu-backdrop(p0); }
                change-quick-menu-backdrop-opacity(p0) => { root.change-quick-menu-backdrop-opacity(p0); }
                change-theme(p0) => { root.change-theme(p0); }
                debug-tools-enabled: root.debug-tools-enabled;
                discover-everything() => { root.discover-everything(); }
                download-everything() => { root.download-everything(); }
                enable-folder-integration() => { root.enable-folder-integration(); }
                enable-win-e-integration() => { root.enable-win-e-integration(); }
                everything-busy: root.everything-busy;
                everything-instance <=> root.everything-instance;
                everything-path <=> root.everything-path;
                everything-status: root.everything-status;
                file-list-quick-search: root.file-list-quick-search;
                folder-integration-bound-path: root.folder-integration-bound-path;
                folder-integration-enabled: root.folder-integration-enabled;
                folder-integration-needs-repair: root.folder-integration-needs-repair;
                folder-integration-status: root.folder-integration-status;
                language-mode: root.language-mode;
                minimal: root.minimal;
                new-tab-opens-home: root.new-tab-opens-home;
                quick-menu-backdrop: root.quick-menu-backdrop;
                quick-menu-backdrop-opacity: root.quick-menu-backdrop-opacity;
                repair-folder-integration() => { root.repair-folder-integration(); }
                repair-win-e-integration() => { root.repair-win-e-integration(); }
                restore-folder-integration() => { root.restore-folder-integration(); }
                restore-win-e-integration() => { root.restore-win-e-integration(); }
                scrollbar-pointer-active <=> root.scrollbar-pointer-active;
                select-everything-program() => { root.select-everything-program(); }
                settings-section <=> root.settings-section;
                show-debug-window(p0) => { root.show-debug-window(p0); }
                show-hidden-files: root.show-hidden-files;
                show-system-files: root.show-system-files;
                start-everything() => { root.start-everything(); }
                start-window-trace() => { root.start-window-trace(); }
                system-integration-busy: root.system-integration-busy;
                test-everything-connection() => { root.test-everything-connection(); }
                theme-mode: root.theme-mode;
                update-everything-config(p0, p1) => { root.update-everything-config(p0, p1); }
                win-e-integration-bound-path: root.win-e-integration-bound-path;
                win-e-integration-enabled: root.win-e-integration-enabled;
                win-e-integration-needs-repair: root.win-e-integration-needs-repair;
                win-e-integration-status: root.win-e-integration-status;
                window-trace-active: root.window-trace-active;
                window-trace-status: root.window-trace-status;
            }
        }

        overlays := WindowOverlays {
            normal-name-width: root.normal-name-width;
            normal-kind-width: root.normal-kind-width;
            normal-size-width: root.normal-size-width;
            normal-modified-width: root.normal-modified-width;
            normal-created-width: root.normal-created-width;
            search-name-width: root.search-name-width;
            search-parent-width: root.search-parent-width;
            search-size-width: root.search-size-width;
            search-modified-width: root.search-modified-width;
            search-created-width: root.search-created-width;
            view-mode: root.view-mode;
            width: parent.width; height: parent.height;
            accessibility-window-id: root.accessibility-window-id;
            activate-tab(p0) => { root.activate-tab(p0); }
            context-menu-open <=> root.context-menu-open;
            dismiss-context-menu() => { root.dismiss-context-menu(); }
            reveal-tab(index) => { tab-bar.reveal-tab(index); }
            search-results-mode: root.search-results-mode;
            tab-strip-width: root.tab-strip-width;
            tabs: root.tabs;
            tabs-menu-open <=> root.tabs-menu-open;
            tabs-overflow: root.tabs-overflow;
            window-actual-width: root.width;
            window-height: root.height;
            window-origin: root.absolute-position;
        }
    }
}
