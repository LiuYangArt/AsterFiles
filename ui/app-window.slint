import { Button, LineEdit, ListView } from "std-widgets.slint";

export struct FileRow {
    id: int,
    name: string,
    kind: string,
    size: string,
    modified: string,
    is-directory: bool,
}

export struct TabRow {
    id: int,
    title: string,
    active: bool,
    loading: bool,
}

export component AppWindow inherits Window {
    title: "AsterFiles";
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 820px;
    min-height: 520px;
    background: #f5f6f8;
    default-font-family: "Segoe UI";

    in-out property <string> current-path: "C:\\";
    in property <string> status-text: "";
    in property <[FileRow]> files;
    in property <[TabRow]> tabs;
    in property <bool> can-close-tab: false;
    in property <bool> can-restore-tab: false;
    in property <string> language-label: "EN";
    in property <string> text-go: "前往";
    in property <string> text-home: "主页";
    in property <string> text-desktop: "桌面";
    in property <string> text-downloads: "下载";
    in property <string> text-documents: "文档";
    in property <string> text-pictures: "图片";
    in property <string> text-drives: "磁盘";
    in property <string> text-name: "名称";
    in property <string> text-type: "类型";
    in property <string> text-modified: "修改时间";
    in property <string> text-size: "大小";

    callback navigate-path(string);
    callback open-entry(int);
    callback new-tab();
    callback close-tab();
    callback restore-tab();
    callback activate-tab(int);
    callback toggle-language();

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 46px;
            background: #ffffff;
            border-color: #e7e8eb;
            border-width: 1px;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 6px;
                Text { text: "AsterFiles"; width: 100px; color: #1e1f24; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                for tab in root.tabs: Rectangle {
                    width: 170px;
                    background: tab.active ? #eef2ff : #f7f7f8;
                    border-color: tab.active ? #a9b8f8 : #e2e3e7;
                    border-width: 1px;
                    border-radius: 6px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 8px;
                        spacing: 5px;
                        Text { text: tab.loading ? "…" : ""; color: #5b5ce2; vertical-alignment: center; }
                        Text { text: tab.title; color: #303138; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    }
                    tab-click := TouchArea { clicked => { root.activate-tab(tab.id); } }
                }
                Button { text: "+"; clicked => { root.new-tab(); } }
                Button { text: "×"; enabled: root.can-close-tab; clicked => { root.close-tab(); } }
                Button { text: "↶"; enabled: root.can-restore-tab; clicked => { root.restore-tab(); } }
                Rectangle { horizontal-stretch: 1; }
                Button { text: root.language-label; clicked => { root.toggle-language(); } }
            }
        }

        Rectangle {
            height: 58px;
            background: #fafbfc;
            border-color: #e7e8eb;
            border-width: 1px;
            HorizontalLayout {
                padding-top: 10px;
                padding-bottom: 10px;
                padding-left: 14px;
                padding-right: 14px;
                spacing: 8px;
                LineEdit {
                    text <=> root.current-path;
                    horizontal-stretch: 1;
                    accepted => { root.navigate-path(self.text); }
                }
                Button { text: root.text-go; clicked => { root.navigate-path(root.current-path); } }
            }
        }

        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: 218px;
                background: #f1f2f5;
                border-color: #e2e3e7;
                border-width: 1px;
                VerticalLayout {
                    padding-top: 14px;
                    padding-bottom: 14px;
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    Text { text: root.text-home; font-size: 13px; font-weight: 700; color: #2b2c31; }
                    Text { text: root.text-desktop; font-size: 13px; color: #60626c; }
                    Text { text: root.text-downloads; font-size: 13px; color: #60626c; }
                    Text { text: root.text-documents; font-size: 13px; color: #60626c; }
                    Text { text: root.text-pictures; font-size: 13px; color: #60626c; }
                    Rectangle { height: 12px; }
                    Text { text: root.text-drives; font-size: 12px; font-weight: 700; color: #8b8d96; }
                    Text { text: "Windows (C:)"; font-size: 13px; color: #60626c; }
                    Rectangle { vertical-stretch: 1; }
                }
            }

            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: 38px;
                    background: #ffffff;
                    border-color: #e7e8eb;
                    border-width: 1px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 12px;
                        Text { text: root.text-name; width: 52%; color: #696b74; font-size: 12px; vertical-alignment: center; }
                        Text { text: root.text-type; width: 16%; color: #696b74; font-size: 12px; vertical-alignment: center; }
                        Text { text: root.text-modified; width: 18%; color: #696b74; font-size: 12px; vertical-alignment: center; }
                        Text { text: root.text-size; horizontal-stretch: 1; color: #696b74; font-size: 12px; vertical-alignment: center; }
                    }
                }

                list := ListView {
                    for entry in root.files: Rectangle {
                        height: 38px;
                        background: mouse.has-hover ? #eff4ff : #ffffff;
                        border-color: #f1f1f3;
                        border-width: 1px;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 12px;
                            Text { text: entry.is-directory ? "▸  " + entry.name : "    " + entry.name; width: 52%; color: #24252a; font-size: 13px; vertical-alignment: center; overflow: elide; }
                            Text { text: entry.kind; width: 16%; color: #6f717a; font-size: 12px; vertical-alignment: center; }
                            Text { text: entry.modified; width: 18%; color: #6f717a; font-size: 12px; vertical-alignment: center; }
                            Text { text: entry.size; horizontal-stretch: 1; color: #6f717a; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                        }
                        mouse := TouchArea { clicked => { if (entry.is-directory) { root.open-entry(entry.id); } } }
                    }
                }

                Rectangle {
                    height: 30px;
                    background: #fafbfc;
                    border-color: #e7e8eb;
                    border-width: 1px;
                    Text { x: 14px; text: root.status-text; color: #72747d; font-size: 11px; vertical-alignment: center; }
                }
            }
        }
    }
}
