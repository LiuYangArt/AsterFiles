import { CheckBox, ListView } from "std-widgets.slint";
import { IconMap } from "icons/icon-map.slint";
export { PopupCommandRow, QuickMenuWindow, QuickSubmenuWindow } from "quick-menu.slint";

export struct HighlightSegment { text: string, highlighted: bool }
export struct FileRow { id: int, loaded: bool, group-header: bool, group-label: string, group-count: int, name: string, name-segments: [HighlightSegment], kind: string, parent-path: string, size: string, modified: string, created: string, is-directory: bool, selected: bool, focused: bool, cut: bool, icon: image }
export struct GridRow { group-header: bool, group-label: string, group-count: int, entries: [FileRow] }
export struct HistoryRow { index: int, label: string }
export struct BreadcrumbRow { index: int, label: string, current: bool }
export struct TabRow { id: int, title: string, active: bool, loading: bool, icon: image, is-drive: bool, is-settings: bool }
export struct SidebarRow { index: int, label: string, icon-kind: int, is-drive: bool, icon: image }
export struct ColumnRow { kind: int, label: string, visible: bool, min-width: length, content-left: length, content-right: length, icon-slot: length }
export struct ContextCommandRow { id: int, node-id: int, label: string, search-text: string, hint: string, enabled: bool, separator: bool, shell: bool, checked: bool, default: bool, submenu: bool, loading: bool, placeholder: bool, icon-kind: int }
export struct OperationRow { id: int, title: string, percent: string, file-progress: string, transferred: string, speed: string, eta: string, current-item: string, source: string, destination: string, progress: float, state: int, paused: bool, can-pause: bool, can-cancel: bool, can-retry: bool }
export global VisualStyle {
    in-out property <bool> dark-theme: false;
    out property <color> c24252a: dark-theme ? #f2f2f2 : #24252a;
    out property <color> c303138: dark-theme ? #f2f2f2 : #303138;
    out property <color> c30333a: dark-theme ? #f2f2f2 : #30333a;
    out property <color> c323437: #323437;
    out property <color> c57595c: dark-theme ? #57595c : #75787c;
    out property <color> c3b4f83: dark-theme ? #9db5ff : #3b4f83;
    out property <color> c4f535d: dark-theme ? #d0d0d0 : #4f535d;
    out property <color> c4f6bed: dark-theme ? #7fa0ff : #4f6bed;
    out property <color> rectangle-selection-fill: dark-theme ? #7fa0ff1a : #4f6bed1a;
    out property <color> rectangle-selection-border: dark-theme ? #7fa0ff99 : #4f6bed99;
    out property <color> c62656f: dark-theme ? #c6c6c6 : #62656f;
    out property <color> c666a74: dark-theme ? #bcbcbc : #666a74;
    out property <color> c696b74: dark-theme ? #bdbdbd : #696b74;
    out property <color> c6f717a: dark-theme ? #bdbdbd : #6f717a;
    out property <color> c72747d: dark-theme ? #a9a9a9 : #72747d;
    out property <color> c777a84: dark-theme ? #b0b0b0 : #777a84;
    out property <color> c777b85: dark-theme ? #b0b0b0 : #777b85;
    out property <color> c9a9da3: dark-theme ? #8a8a8a : #9a9da3;
    out property <color> caeb1b6: dark-theme ? #737373 : #aeb1b6;
    out property <color> cc42b1c: #c42b1c;
    out property <color> cc7d7ff: dark-theme ? #35548f : #c7d7ff;
    out property <color> cd7dae0: dark-theme ? #4a4a4a : #d7dae0;
    out property <color> cd7dce5: dark-theme ? #4a4a4a : #d7dce5;
    out property <color> cd9dce2: dark-theme ? #454545 : #d9dce2;
    out property <color> cdce6ff: dark-theme ? #263d66 : #dce6ff;
    out property <color> cdde3ed: dark-theme ? #464646 : #dde3ed;
    out property <color> ce0e2e7: dark-theme ? #4b4b4b : #e0e2e7;
    out property <color> ce1e4ea: dark-theme ? #4c4c4c : #e1e4ea;
    out property <color> ce2e3e7: dark-theme ? #484848 : #e2e3e7;
    out property <color> ce2e4e9: dark-theme ? #444444 : #e2e4e9;
    out property <color> ce3e7ef: dark-theme ? #424242 : #e3e7ef;
    out property <color> ce5e9f2: dark-theme ? #414141 : #e5e9f2;
    out property <color> ce7e8eb: dark-theme ? #404040 : #e7e8eb;
    out property <color> ce8eaf0: dark-theme ? #3d3d3d : #e8eaf0;
    out property <color> cedf1f6: dark-theme ? #424242 : #edf1f6;
    out property <color> ceff4ff: dark-theme ? #303b4d : #eff4ff;
    out property <color> cf1f2f4: dark-theme ? #343434 : #f1f2f4;
    out property <color> cf1f2f5: dark-theme ? #292929 : #f1f2f5;
    out property <color> cf5f6f8: dark-theme ? #202020 : #f5f6f8;
    out property <color> cf8f8f9: dark-theme ? #303030 : #f8f8f9;
    out property <color> cfafbfc: dark-theme ? #272727 : #fafbfc;
    out property <color> cffffff: dark-theme ? #252525 : #ffffff;
    out property <length> tab-shoulder-width: 7px;
    out property <length> tab-shoulder-span: 14px;
}

component StandaloneActionButton inherits Rectangle {
    in property <image> icon-source;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> dangerous: false;
    in property <bool> center-content: true;
    callback clicked();
    width: 96px;
    height: 34px;
    horizontal-stretch: 0;
    border-radius: 5px;
    border-width: 1px;
    border-color: root.dangerous ? VisualStyle.cc42b1c : VisualStyle.ce0e2e7;
    background: !root.enabled ? VisualStyle.cf8f8f9 : button-touch.pressed ? (root.dangerous ? #a4261a : VisualStyle.cdce6ff) : button-touch.has-hover ? (root.dangerous ? VisualStyle.cc42b1c : VisualStyle.ceff4ff) : (root.dangerous ? #b3261e : VisualStyle.cffffff);
    opacity: root.enabled ? 1 : 0.5;
    Rectangle {
        x: 10px; width: parent.width - 20px; height: parent.height;
        HorizontalLayout {
            spacing: 6px; alignment: root.center-content ? center : start;
            if root.icon-source.width != 0: Rectangle { width: 16px; vertical-stretch: 1; Image { width: 16px; height: 16px; y: (parent.height - self.height) / 2; source: root.icon-source; image-fit: contain; colorize: VisualStyle.c303138; } }
            Text { horizontal-stretch: root.center-content ? 0 : 1; text: root.label; color: root.dangerous ? #ffffff : VisualStyle.c30333a; font-size: 12px; vertical-alignment: center; overflow: elide; }
        }
    }
    button-touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
}

component StandaloneTitleBar inherits Rectangle {
    in property <string> title;
    in property <string> close-label: "关闭";
    in property <bool> show-minimize: false;
    callback close-requested();
    callback minimize-requested();
    callback drag-window();
    height: 48px;
    background: VisualStyle.cffffff;
    HorizontalLayout {
        padding-left: 16px;
        Text { text: root.title; color: VisualStyle.c30333a; font-size: 16px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        Rectangle { visible: root.show-minimize; width: 46px; Text { text: "—"; color: VisualStyle.c303138; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.minimize-requested(); } } }
        Rectangle { width: 46px; Text { text: "×"; color: VisualStyle.c303138; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { root.close-requested(); } } accessible-role: button; accessible-label: root.close-label; }
    }
    TouchArea { width: parent.width - 46px - (root.show-minimize ? 46px : 0px); pointer-event(event) => { if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { root.drag-window(); } } }
}

export component OperationWindow inherits Window {
    title: root.text-file-operations;
    icon: @image-url("../assets/app-icon.png");
    no-frame: true;
    resize-border-width: 0px;
    preferred-width: 580px;
    preferred-height: 255px;
    min-width: 580px;
    max-width: 580px;
    min-height: 255px;
    max-height: 255px;
    background: VisualStyle.cffffff;
    default-font-family: "Segoe UI";

    in property <[OperationRow]> operations;
    in property <bool> dark-theme: false;
    in property <string> text-file-operations: "文件操作";
    in property <string> text-cancel-operation: "取消";
    in property <string> text-retry-operation: "重试";
    in property <string> text-no-operations: "没有文件操作";
    in property <string> text-window-minimize: "最小化";
    in property <string> text-window-close: "关闭";
    in property <string> text-pause-operation: "暂停";
    in property <string> text-resume-operation: "继续";

    callback cancel-operation(int);
    callback toggle-pause-operation(int);
    callback retry-operation(int);
    callback request-hide();
    callback drag-window();

    changed dark-theme => { VisualStyle.dark-theme = root.dark-theme; }

    VerticalLayout {
        StandaloneTitleBar { title: root.operations.length > 0 ? root.operations[0].title + " | " + root.operations[0].percent : root.text-file-operations; close-label: root.text-window-close; show-minimize: true; minimize-requested => { root.minimized = true; } close-requested => { if (root.operations.length > 0 && root.operations[0].can-cancel) { root.cancel-operation(root.operations[0].id); } else { root.request-hide(); } } drag-window => { root.drag-window(); } }
        Rectangle {
            vertical-stretch: 1;
            background: VisualStyle.cffffff;
            if root.operations.length == 0: Text {
                text: root.text-no-operations;
                color: VisualStyle.c62656f;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if root.operations.length > 0: Rectangle {
                width: parent.width;
                height: parent.height;
                if root.operations.length > 0: Rectangle {
                    property <OperationRow> operation: root.operations[0];
                    width: parent.width;
                    height: parent.height;
                    background: VisualStyle.cffffff;
                    Text { x: 20px; y: 8px; width: parent.width - 40px; height: 20px; text: "From:  " + operation.source; color: VisualStyle.c62656f; font-size: 12px; overflow: elide; vertical-alignment: center; }
                    Text { x: 20px; y: 32px; width: parent.width - 40px; height: 20px; text: "To:       " + operation.destination; color: VisualStyle.c62656f; font-size: 12px; overflow: elide; vertical-alignment: center; }
                    Text { x: 20px; y: 56px; width: parent.width - 40px; height: 20px; text: "File:     " + operation.current-item; color: VisualStyle.c30333a; font-size: 13px; overflow: elide; vertical-alignment: center; }
                    Rectangle {
                            x: 20px;
                            y: 84px;
                            width: parent.width - 40px;
                            height: 22px;
                            border-radius: 11px;
                            background: VisualStyle.ce0e2e7;
                            Rectangle {
                                x: 0px;
                                width: max(0px, min(parent.width, parent.width * operation.progress));
                                height: parent.height;
                                border-radius: 11px;
                                background: operation.state == 8 || operation.state == 7 ? #b3261e : VisualStyle.cdce6ff;
                            }
                            Text { text: operation.file-progress; color: VisualStyle.c30333a; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                            x: 20px;
                            y: 112px;
                            width: parent.width - 40px;
                            height: 20px;
                            spacing: 20px;
                            Text { text: operation.transferred; color: VisualStyle.c72747d; font-size: 11px; vertical-alignment: center; }
                            Text { text: operation.speed; color: VisualStyle.c72747d; font-size: 11px; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: operation.eta; color: VisualStyle.c62656f; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                            x: parent.width - self.width - 20px;
                            y: 148px;
                            width: 176px;
                            height: 34px;
                            spacing: 8px;
                            StandaloneActionButton { visible: operation.can-pause; width: 84px; label: operation.paused ? root.text-resume-operation : root.text-pause-operation; clicked => { root.toggle-pause-operation(operation.id); } }
                            StandaloneActionButton { visible: operation.can-cancel; width: 84px; label: root.text-cancel-operation; clicked => { root.cancel-operation(operation.id); } }
                            StandaloneActionButton { visible: operation.can-retry; width: 76px; label: root.text-retry-operation; clicked => { root.retry-operation(operation.id); } }
                    }
                }
            }
        }
    }
}

export component ConfirmationWindow inherits Window {
    title: root.title-text;
    icon: @image-url("../assets/app-icon.png");
    no-frame: true;
    resize-border-width: 0px;
    preferred-width: 520px;
    preferred-height: root.kind == 1 ? 286px : 220px;
    min-width: 520px;
    max-width: 520px;
    min-height: root.kind == 1 ? 286px : 220px;
    max-height: root.kind == 1 ? 286px : 220px;
    background: VisualStyle.cffffff;
    default-font-family: "Segoe UI";

    in property <int> kind: 0;
    in property <string> operation-id: "";
    in property <bool> demo-mode: false;
    in property <bool> dark-theme: false;
    in property <string> title-text: "";
    in property <string> detail-text: "";
    in property <string> source-text: "";
    in property <string> destination-text: "";
    in property <string> source-label: "来源：";
    in property <string> destination-label: "目标：";
    in property <string> cancel-text: "取消";
    in property <string> primary-text: "";
    in property <string> secondary-text: "";
    in property <string> tertiary-text: "";
    in property <string> apply-all-text: "";
    in-out property <bool> apply-all: false;
    in property <string> close-text: "关闭";
    callback safe-cancel();
    callback primary-action();
    callback secondary-action();
    callback tertiary-action();
    callback drag-window();

    changed dark-theme => { VisualStyle.dark-theme = root.dark-theme; }

    VerticalLayout {
        StandaloneTitleBar { title: root.title-text; close-label: root.close-text; close-requested => { root.safe-cancel(); } drag-window => { root.drag-window(); } }
        Rectangle {
            vertical-stretch: 1;
            background: VisualStyle.cffffff;
            VerticalLayout {
                padding-left: 20px; padding-right: 20px; padding-top: 12px; padding-bottom: 20px; spacing: 10px;
                Text { text: root.detail-text; color: VisualStyle.c62656f; font-size: 13px; wrap: word-wrap; }
                if root.kind == 1: Text { text: root.source-label + root.source-text; color: VisualStyle.c30333a; font-size: 12px; overflow: elide; }
                if root.kind == 1: Text { text: root.destination-label + root.destination-text; color: VisualStyle.c62656f; font-size: 12px; overflow: elide; }
                if root.kind == 1: StandaloneActionButton { width: 280px; label: (root.apply-all ? "☑ " : "☐ ") + root.apply-all-text; clicked => { root.apply-all = !root.apply-all; } }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end; spacing: 8px;
                    if root.kind == 0: StandaloneActionButton { width: 96px; label: root.cancel-text; clicked => { root.safe-cancel(); } }
                    if root.kind == 1: StandaloneActionButton { width: 108px; label: root.tertiary-text; clicked => { root.tertiary-action(); } }
                    if root.kind == 1: StandaloneActionButton { width: 96px; label: root.secondary-text; clicked => { root.secondary-action(); } }
                    if root.kind == 2: StandaloneActionButton { width: 120px; label: root.secondary-text; clicked => { root.secondary-action(); } }
                    StandaloneActionButton { width: root.kind == 2 ? 150px : 96px; label: root.primary-text; dangerous: root.kind == 0; clicked => { root.primary-action(); } }
                }
            }
        }
    }
}

component InlineIcon inherits Rectangle {
    in property <image> icon-source;
    in property <length> icon-size: 18px;
    width: root.icon-size;
    Image { width: root.icon-size; height: root.icon-size; y: (parent.height - self.height) / 2; source: root.icon-source; }
}

component ActiveTabShape inherits Rectangle {
    in property <color> shape-color;
    background: transparent;

    // Fixed shoulders keep the join stable while only the center follows tab width.
    Rectangle {
        x: VisualStyle.tab-shoulder-width;
        width: parent.width - VisualStyle.tab-shoulder-span;
        height: parent.height;
        border-radius: VisualStyle.tab-shoulder-width;
        background: root.shape-color;
    }
    Rectangle {
        x: VisualStyle.tab-shoulder-width;
        y: parent.height - 10px;
        width: parent.width - VisualStyle.tab-shoulder-span;
        height: 10px;
        background: root.shape-color;
    }
    Path {
        x: 0px;
        y: parent.height - 10px;
        width: VisualStyle.tab-shoulder-width;
        height: 10px;
        viewbox-width: 7;
        viewbox-height: 10;
        commands: "M 0 10 C 4 10 7 7 7 3 L 7 0 L 7 10 Z";
        fill: root.shape-color;
    }
    Path {
        x: parent.width - VisualStyle.tab-shoulder-width;
        y: parent.height - 10px;
        width: VisualStyle.tab-shoulder-width;
        height: 10px;
        viewbox-width: 7;
        viewbox-height: 10;
        commands: "M 0 0 L 0 3 C 0 7 3 10 7 10 L 0 10 Z";
        fill: root.shape-color;
    }
}

component IconButton inherits Rectangle {
    in property <image> icon-source;
    in property <string> tip;
    in property <string> button-label: root.tip;
    in property <bool> enabled: true;
    callback clicked();
    width: 38px;
    height: 38px;
    border-radius: 5px;
    border-width: 0px;
    background: !root.enabled ? transparent : icon-touch.pressed ? VisualStyle.cdde3ed : icon-touch.has-hover ? VisualStyle.cedf1f6 : transparent;
    opacity: root.enabled ? 1 : 0.46;
    Image {
        width: 20px;
        height: 20px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon-source;
        image-fit: contain;
        colorize: VisualStyle.c303138;
    }
    icon-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    accessible-role: button;
    accessible-label: root.button-label;
    accessible-enabled: root.enabled;
    Tooltip { text: @markdown("\{root.tip}"); }
}

component SidebarGroupHeader inherits Rectangle {
    in property <string> label;
    in property <bool> expanded: true;
    callback toggled();
    height: 30px;
    background: group-touch.has-hover ? VisualStyle.ce5e9f2 : transparent;
    border-radius: 5px;
    HorizontalLayout {
        padding-left: 7px; padding-right: 7px; spacing: 7px;
        Rectangle {
            width: 12px; height: parent.height;
            Path {
                x: 2px; y: (parent.height - self.height) / 2; width: 8px; height: 8px;
                viewbox-width: 8; viewbox-height: 8; fit: fill;
                commands: root.expanded ? "M 1 2.5 L 4 5.5 L 7 2.5" : "M 2.5 1 L 5.5 4 L 2.5 7";
                stroke: VisualStyle.c666a74; stroke-width: 1.2px; stroke-line-cap: round; stroke-line-join: round; fill: transparent;
            }
        }
        Text { text: root.label; color: VisualStyle.c777a84; font-size: 12px; font-weight: 700; vertical-alignment: center; }
    }
    group-touch := TouchArea { mouse-cursor: pointer; clicked => { root.toggled(); } }
    accessible-role: button;
    accessible-label: root.label;
}

component WindowButton inherits Rectangle {
    in property <int> kind;
    in property <string> label;
    callback clicked();
    width: 46px;
    height: 40px;
    background: root.kind == 2 && button-touch.has-hover ? VisualStyle.cc42b1c : button-touch.pressed ? VisualStyle.cd9dce2 : button-touch.has-hover ? VisualStyle.ce8eaf0 : transparent;
    Rectangle {
        visible: root.kind == 0;
        width: 10px; height: 1px;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        background: root.kind == 2 && button-touch.has-hover ? VisualStyle.cffffff : VisualStyle.c303138;
    }
    Rectangle {
        visible: root.kind == 1;
        width: 9px; height: 9px;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        border-width: 1px;
        border-color: VisualStyle.c303138;
        background: transparent;
    }
    Image {
        visible: root.kind == 2;
        width: 14px; height: 14px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: button-touch.has-hover ? IconMap.action-close-hover : IconMap.action-close;
        colorize: button-touch.has-hover ? #ffffff : VisualStyle.c303138;
    }
    button-touch := TouchArea { clicked => { root.clicked(); } }
    accessible-role: button;
    accessible-label: root.label;
}

component LightScrollBar inherits Rectangle {
    in property <length> value;
    in property <length> maximum;
    in property <length> page-size;
    callback scrolled(length);

    width: 12px;
    visible: root.maximum > 0px;
    background: scroll-touch.has-hover ? VisualStyle.cf1f2f4 : transparent;
    border-radius: 6px;

    private property <length> track-padding: 4px;
    private property <length> track-height: root.height - 2 * root.track-padding;
    private property <length> thumb-height: max(28px, root.track-height * root.page-size / (root.maximum + root.page-size));
    private property <length> thumb-travel: max(0px, root.track-height - root.thumb-height);

    thumb := Rectangle {
        width: scroll-touch.has-hover ? 6px : 3px;
        height: root.thumb-height;
        x: parent.width - self.width - 3px;
        y: root.track-padding + root.thumb-travel * (-root.value / root.maximum);
        border-radius: self.width / 2;
        background: scroll-touch.has-hover ? VisualStyle.c9a9da3 : VisualStyle.caeb1b6;
    }

    scroll-touch := TouchArea {
        property <length> press-value;
        property <length> press-y;
        property <bool> dragging-thumb;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                if self.mouse-y < thumb.y {
                    root.scrolled(min(0px, root.value + root.page-size));
                } else if self.mouse-y > thumb.y + thumb.height {
                    root.scrolled(max(-root.maximum, root.value - root.page-size));
                } else {
                    self.press-value = root.value;
                    self.press-y = self.mouse-y;
                    self.dragging-thumb = true;
                }
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                self.dragging-thumb = false;
            }
        }
        moved => {
            if self.pressed && self.dragging-thumb && root.thumb-travel > 0px {
                root.scrolled(max(-root.maximum, min(0px, self.press-value - (self.mouse-y - self.press-y) * root.maximum / root.thumb-travel)));
            }
        }
    }
}

component BreadcrumbButton inherits Rectangle {
    in property <string> label;
    in property <bool> current: false;
    callback clicked();
    min-width: 42px;
    height: 30px;
    border-radius: 4px;
    background: !root.current && crumb-touch.has-hover ? VisualStyle.cedf1f6 : transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 5px;
        Text { text: root.label; color: VisualStyle.c30333a; font-size: 12px; font-weight: root.current ? 600 : 400; vertical-alignment: center; }
        Text { visible: !root.current; text: "›"; color: VisualStyle.c777b85; font-size: 14px; vertical-alignment: center; }
    }
    crumb-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: true;
}

component AddressEditor inherits Rectangle {
    in-out property <string> text;
    in property <bool> has-error: false;
    in property <string> address-label;
    in property <string> cancel-label;
    in property <bool> depth-enabled: false;
    in property <bool> recursive: true;
    in property <string> depth-label;
    callback accepted(string);
    callback changed(string);
    callback cancelled();
    callback toggle-depth();

    public function focus-at-end() {
        editor.focus();
        editor.set-selection-offsets(2147483647, 2147483647);
    }

    background: VisualStyle.cffffff;
    forward-focus: editor;
    property <bool> editor-has-focus: editor.has-focus;



    Rectangle {
        x: 0px;
        width: 30px;
        height: parent.height;
        border-radius: 4px;
        background: root.depth-enabled ? (depth-touch.pressed ? VisualStyle.cdde3ed : depth-touch.has-hover ? VisualStyle.cedf1f6 : transparent) : transparent;
        opacity: root.depth-enabled ? 1 : 0.35;
        Image {
            width: 18px; height: 18px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            source: root.recursive ? IconMap.action-search-recursive : IconMap.action-search-current;
            colorize: VisualStyle.c303138;
        }
        depth-touch := TouchArea {
            enabled: root.depth-enabled;
            mouse-cursor: root.depth-enabled ? pointer : default;
            clicked => { root.toggle-depth(); }
        }
        accessible-role: button;
        accessible-label: root.depth-label;
        accessible-enabled: root.depth-enabled;
    }

    editor := TextInput {
        x: 32px;
        width: parent.width - 70px;
        height: parent.height;
        text <=> root.text;
        color: VisualStyle.c30333a;
        selection-background-color: VisualStyle.cc7d7ff;
        selection-foreground-color: VisualStyle.c24252a;
        font-size: 13px;
        single-line: true;
        vertical-alignment: center;
        accessible-role: text-input;
        accessible-label: root.address-label;
        edited => { root.changed(root.text); }
        accepted => { root.accepted(root.text); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancelled();
                return accept;
            }
            if event.text == Key.Tab && !event.modifiers.shift && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta {
                if root.depth-enabled {
                    root.toggle-depth();
                    return accept;
                }
                return reject;
            }
            return reject;
        }
    }


    Rectangle {
        x: parent.width - 30px;
        width: 30px;
        height: parent.height;
        border-radius: 4px;
        background: dismiss-touch.pressed ? VisualStyle.cdde3ed : dismiss-touch.has-hover ? VisualStyle.cedf1f6 : transparent;
        Image {
            width: 16px;
            height: 16px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            source: IconMap.action-close;
            colorize: VisualStyle.c303138;
        }
        dismiss-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.cancelled(); }
        }
        accessible-role: button;
        accessible-label: root.cancel-label;
    }
}

export component AppWindow inherits Window {
    title: "AsterFiles";
    icon: @image-url("../assets/app-icon.png");
    no-frame: true;
    // Windows cannot start an edge resize while maximized. Keeping the hit area active there can
    // leave winit waiting forever for a system resize loop that never began.
    resize-border-width: root.maximized ? 0px : 14px;
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 820px;
    min-height: 520px;
    background: VisualStyle.cf5f6f8;
    changed dark-theme => { VisualStyle.dark-theme = root.dark-theme; }
    in property <length> window-width: 1180px;
    default-font-family: "Segoe UI";

    in property <string> current-path: "C:\\";
    in property <image> current-location-icon;
    in property <bool> current-location-is-drive: false;
    in-out property <string> address-input: "C:\\";
    in property <bool> address-editing: false;
    in property <bool> search-mode: false;
    in property <bool> search-results-mode: false;
    in property <bool> search-depth-enabled: false;
    in property <bool> search-recursive: true;


    in property <string> status-text: "";
    in property <string> error-page-title: "";
    in property <string> error-page-description: "";
    in property <string> text-request-access: "使用 Windows 请求访问权限";
    in property <bool> show-request-access: false;


    in property <[FileRow]> files;
    in property <[GridRow]> grid-rows;
    in property <int> grid-column-count: 1;
    in-out property <int> projected-file-tab-id: -1;
    in-out property <int> projected-file-request-id: -1;
    in property <[TabRow]> tabs;
    in property <[HistoryRow]> back-history;
    in property <[HistoryRow]> forward-history;
    in property <[BreadcrumbRow]> breadcrumbs;
    in property <[SidebarRow]> sidebar-items;
    in property <[ColumnRow]> columns;
    in property <float> insertion-indicator-width: 5;
    in property <color> insertion-indicator-color: #4f6bed;
    in property <[ContextCommandRow]> context-commands;
    in property <[ContextCommandRow]> context-submenu-commands;
    in property <[ContextCommandRow]> context-submenu-parent-commands;
    in-out property <string> context-search: "";
    in-out property <int> context-active-index: -1;
    in-out property <int> context-submenu-active-index: -1;
    in-out property <bool> context-submenu-open: false;
    in-out property <bool> context-submenu-loading: false;
    in-out property <bool> context-submenu-parent-open: false;
    in-out property <length> context-submenu-anchor-y: 0px;
    in-out property <length> context-submenu-parent-anchor-y: 0px;
    in-out property <length> context-active-anchor-y: 0px;
    in-out property <length> context-submenu-active-anchor-y: 0px;
    in-out property <length> context-menu-content-height: 0px;
    in-out property <length> context-submenu-content-height: 0px;
    in-out property <length> context-submenu-parent-content-height: 0px;
    in-out property <bool> context-shell-loading: false;
    in-out property <int> context-shell-elapsed-ms: 0;
    in property <string> text-context-search: "搜索命令";
    in property <string> text-context-loading: "正在加载 Windows 菜单…";
    in property <string> text-context-empty: "没有匹配的命令";
    in property <[OperationRow]> operations;
    in-out property <length> file-viewport-y: 0px;
    private property <length> list-viewport-y: 0px;
    private property <length> grid-viewport-y: 0px;
    in property <int> projected-content-revision: 0;
    private property <int> active-geometry-revision: root.view-mode * 1000003 + root.projected-content-revision;
    in-out property <length> search-scroll-y: 0px;
    in property <int> search-total-items: 0;
    out property <length> file-list-left: 0px;
    out property <length> file-list-top: 0px;
    out property <length> rectangle-viewport-top: 0px;
    out property <length> file-viewport-width: 0px;
    out property <length> file-viewport-height: 0px;
    in-out property <int> view-mode: 0;
    public pure function is-grid-view-mode(mode: int) -> bool {
        return mode == 2 || mode == 3 || mode == 4 || mode == 5 || mode == 6;
    }
    public pure function is-icon-view-mode(mode: int) -> bool {
        return mode == 2 || mode == 3 || mode == 4 || mode == 5;
    }
    public pure function view-row-height(mode: int) -> length {
        return mode == 1 ? 34px
            : mode == 7 ? 76px
            : mode == 3 ? 86px
            : mode == 4 ? 196px
            : mode == 5 ? 220px
            : mode == 6 ? 86px
            : mode == 2 ? 148px
            : 40px;
    }
    public pure function view-card-width(mode: int) -> length {
        return mode == 3 ? 88px
            : mode == 4 ? 188px
            : mode == 5 ? 196px
            : mode == 6 ? 292px
            : 140px;
    }
    public pure function view-icon-size(mode: int) -> length {
        return mode == 3 ? 32px
            : mode == 4 ? 148px
            : mode == 5 ? 168px
            : mode == 6 ? 48px
            : 100px;
    }
    function sync-active-file-viewport() {
        if root.is-grid-view-mode(root.view-mode) {
            root.grid-viewport-y = root.file-viewport-y;
        } else {
            root.list-viewport-y = root.file-viewport-y;
        }
    }
    changed file-viewport-y => { root.sync-active-file-viewport(); }

    in-out property <bool> context-menu-open: false;
