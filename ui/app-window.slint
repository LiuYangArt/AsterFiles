    callback navigate-path(string);
    callback begin-address-edit();
    callback cancel-address-edit();
    callback navigate-back();
    callback navigate-forward();
    callback navigate-history(bool, int);
    callback navigate-up();
    callback refresh();
    callback request-folder-access();

    callback navigate-sidebar(int);
    callback navigate-breadcrumb(int);
    callback select-entry(int, bool, bool);
    callback clear-selection();
    callback select-all();
    callback move-focus(int, bool);
    callback focus-boundary(bool, bool);
    callback toggle-focused();
    callback change-sort(int);
    callback reorder-column(int, int);
    callback open-entry(int);
    callback activate-entry(int, bool, bool);
    callback new-tab();
    callback close-tab(int);
    callback restore-tab();
    callback activate-tab(int);
    callback open-settings();
    callback change-theme(int);
    callback change-language(int);
    callback drag-window();
    callback show-entry-menu(int, float, float);
    callback show-background-menu(float, float);
    callback invoke-context-command(int);
    callback copy-selection(bool);
    callback paste-files();
    callback begin-rename();
    callback commit-rename(string);
    callback cancel-rename();
    callback request-delete(bool);
    callback confirm-permanent-delete();
    callback cancel-permanent-delete();
    callback cancel-operation(int);
    callback retry-operation(int);
    callback resolve-conflict(int, bool);
    callback request-close();
    callback wait-on-close();
    callback cancel-tasks-and-close();

    private property <bool> compact: root.window-width < 1000px;
    private property <length> context-menu-anchor-x: 24px;
    private property <length> context-menu-anchor-y: 140px;
    private property <length> keyboard-menu-anchor-x: 24px;
    private property <length> keyboard-menu-anchor-y: 140px;
    private property <bool> menu-open: false;
    private property <int> settings-section: 0;
    private property <bool> minimal: root.window-width < 900px;
    // Keep a compact drag target between the add button and window controls.
    private property <length> max-tab-cluster-width: max(80px, root.window-width - 8px - 34px - 34px - 36px - 3 * 46px - 12px);
    private property <bool> tabs-overflow: root.tabs.length * 80px + 5px * max(0, root.tabs.length - 1) > root.max-tab-cluster-width;
    private property <length> max-tab-strip-width: max(80px, root.max-tab-cluster-width - (root.tabs-overflow ? 33px : 0px));
    private property <length> tab-width: root.tabs.length == 0 ? 178px : max(80px, min(178px, (root.max-tab-strip-width - 5px * max(0, root.tabs.length - 1)) / root.tabs.length));
    private property <length> tab-content-width: root.tabs.length * root.tab-width + 5px * max(0, root.tabs.length - 1);
    private property <length> tab-strip-width: min(root.max-tab-strip-width, root.tab-content-width);
    private property <bool> tabs-menu-open: false;
    in property <int> active-tab-index: 0;
    changed active-tab-index => { root.reveal-tab(root.active-tab-index); }

    public function focus-address-editor() { address-editor.focus-and-select-all(); }
    public function show-keyboard-context-menu() {
        root.context-menu-anchor-x = root.keyboard-menu-anchor-x;
        root.context-menu-anchor-y = root.keyboard-menu-anchor-y;
        if root.context-menu-has-entry {
            root.show-entry-menu(
                -1,
                root.context-menu-anchor-x / 1px,
                root.context-menu-anchor-y / 1px
            );
        } else {
            root.show-background-menu(
                root.context-menu-anchor-x / 1px,
                root.context-menu-anchor-y / 1px
            );
        }
    }
    public function context-menu-x() -> float { return root.context-menu-anchor-x / 1px; }
    public function context-menu-y() -> float { return root.context-menu-anchor-y / 1px; }
    function reveal-tab(index: int) {
        if !root.tabs-overflow {
            tab-strip.viewport-x = 0px;
        } else {
            if index * (root.tab-width + 5px) + tab-strip.viewport-x < 0px {
                tab-strip.viewport-x = -index * (root.tab-width + 5px);
            }
            if index * (root.tab-width + 5px) + root.tab-width + tab-strip.viewport-x > tab-strip.width {
                tab-strip.viewport-x = tab-strip.width - index * (root.tab-width + 5px) - root.tab-width;
            }
            tab-strip.viewport-x = max(tab-strip.width - tab-strip.viewport-width, min(0px, tab-strip.viewport-x));
        }
    }

    forward-focus: shortcut-handler;
    shortcut-handler := FocusScope {
        width: parent.width;
        height: parent.height;
        KeyBinding { keys: @keys(Alt + LeftArrow); enabled: root.can-navigate-back; activated => { root.navigate-back(); } }
        KeyBinding { keys: @keys(Alt + RightArrow); enabled: root.can-navigate-forward; activated => { root.navigate-forward(); } }
        KeyBinding { keys: @keys(Alt + UpArrow); enabled: root.can-navigate-up; activated => { root.navigate-up(); } }
        KeyBinding { keys: @keys(F5); enabled: root.can-refresh; activated => { root.refresh(); } }
        KeyBinding { keys: @keys(Control + R); enabled: root.can-refresh; activated => { root.refresh(); } }
        KeyBinding { keys: @keys(Control + L); enabled: !root.active-is-settings; activated => { root.begin-address-edit(); } }
        KeyBinding { keys: @keys(Alt + D); enabled: !root.active-is-settings; activated => { root.begin-address-edit(); } }
        KeyBinding { keys: @keys(Control + A); enabled: !root.active-is-settings && !root.address-editing; activated => { root.select-all(); } }
        KeyBinding { keys: @keys(Control + Space); enabled: !root.active-is-settings && !root.address-editing; activated => { root.toggle-focused(); } }
        KeyBinding { keys: @keys(UpArrow); enabled: !root.active-is-settings && !root.address-editing; activated => { root.move-focus(-1, false); } }
        KeyBinding { keys: @keys(DownArrow); enabled: !root.active-is-settings && !root.address-editing; activated => { root.move-focus(1, false); } }
        KeyBinding { keys: @keys(Shift + UpArrow); enabled: !root.active-is-settings && !root.address-editing; activated => { root.move-focus(-1, true); } }
        KeyBinding { keys: @keys(Shift + DownArrow); enabled: !root.active-is-settings && !root.address-editing; activated => { root.move-focus(1, true); } }
        KeyBinding { keys: @keys(Home); enabled: !root.active-is-settings && !root.address-editing; activated => { root.focus-boundary(false, false); } }
        KeyBinding { keys: @keys(End); enabled: !root.active-is-settings && !root.address-editing; activated => { root.focus-boundary(true, false); } }
        KeyBinding { keys: @keys(Shift + Home); enabled: !root.active-is-settings && !root.address-editing; activated => { root.focus-boundary(false, true); } }
        KeyBinding { keys: @keys(Shift + End); enabled: !root.active-is-settings && !root.address-editing; activated => { root.focus-boundary(true, true); } }
        KeyBinding { keys: @keys(Return); enabled: !root.active-is-settings && !root.address-editing; activated => { root.open-entry(-1); } }
        KeyBinding { keys: @keys(Escape); enabled: !root.active-is-settings && !root.address-editing; activated => { root.clear-selection(); } }
        KeyBinding { keys: @keys(Control + T); activated => { root.new-tab(); } }
        KeyBinding { keys: @keys(Control + W); enabled: root.can-close-tab; activated => { root.close-tab(-1); } }
        KeyBinding { keys: @keys(Control + C); enabled: !root.active-is-settings && !root.address-editing; activated => { root.copy-selection(false); } }
        KeyBinding { keys: @keys(Control + X); enabled: !root.active-is-settings && !root.address-editing; activated => { root.copy-selection(true); } }
        KeyBinding { keys: @keys(Control + V); enabled: !root.active-is-settings && !root.address-editing; activated => { root.paste-files(); } }
        KeyBinding { keys: @keys(F2); enabled: !root.active-is-settings && !root.address-editing; activated => { root.begin-rename(); } }
        KeyBinding { keys: @keys(Delete); enabled: !root.active-is-settings && !root.address-editing; activated => { root.request-delete(false); } }
        KeyBinding { keys: @keys(Shift + Delete); enabled: !root.active-is-settings && !root.address-editing; activated => { root.request-delete(true); } }
        KeyBinding {
            keys: @keys(Shift + F10);
            enabled: !root.active-is-settings && !root.address-editing;
            activated => { root.show-keyboard-context-menu(); }
        }

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 46px; background: VisualStyle.cf1f2f5;
            HorizontalLayout {
                x: 8px; y: 12px; width: parent.width - 8px - 3 * 46px; height: 34px; spacing: 5px;
                Rectangle {
                    width: 34px; height: 34px; border-radius: 6px;
                    background: menu-touch.pressed ? VisualStyle.cd9dce2 : menu-touch.has-hover ? VisualStyle.ce8eaf0 : transparent;
                    Image { width: 20px; height: 20px; x: 7px; y: 7px; source: IconMap.action-menu; colorize: VisualStyle.c303138; }
                    menu-touch := TouchArea { mouse-cursor: pointer; clicked => { root.menu-open = !root.menu-open; } }
                    accessible-role: button; accessible-label: root.text-menu;
                    Tooltip { text: @markdown("\{root.text-menu}"); }
                }
                Rectangle {
                    width: root.tab-strip-width; height: 34px; clip: true;
                    tab-strip := Flickable {
                    width: parent.width; height: parent.height;
                    interactive: false;
                    viewport-width: root.tab-content-width;
                    viewport-height: self.height;
                    changed width => { root.reveal-tab(root.active-tab-index); }
                    Rectangle {
                        width: root.tab-content-width; height: 34px;
                        HorizontalLayout {
                        width: parent.width; height: parent.height; spacing: 5px;
                        for tab[index] in root.tabs: Rectangle {
                            width: root.tab-width; height: 34px;

                            background: tab.active ? VisualStyle.c323437 : (tab-touch.has-hover ? VisualStyle.ce8eaf0 : VisualStyle.cf1f2f5);
                            border-width: 0px;
                            border-radius: tab.active ? 7px : 0px;
                            Path {
                                visible: tab.active;
                                x: -7px; y: parent.height - 10px; width: parent.width + 14px; height: 10px;
                                viewbox-width: 100; viewbox-height: 10; fit: fill; clip: true;
                                commands: "M 0 10 C 2 10 3.6 8 3.6 5 L 3.6 0 L 96.4 0 L 96.4 5 C 96.4 8 98 10 100 10 Z";
                                fill: VisualStyle.c323437;
                            }
                            tab-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.activate-tab(tab.id); root.reveal-tab(index); }
                                pointer-event(event) => {
                                    if (event.button == PointerEventButton.middle && event.kind == PointerEventKind.up && root.can-close-tab) {
                                        root.close-tab(tab.id);
                                    }
                                }
                                scroll-event(event) => {
                                    tab-strip.viewport-x = max(tab-strip.width - tab-strip.viewport-width, min(0px, tab-strip.viewport-x + (event.delta-x != 0px ? event.delta-x : event.delta-y)));
                                    return accept;
                                }
                            }
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 7px; spacing: 6px;
                                InlineIcon { icon-source: tab.is-settings ? IconMap.action-settings : (tab.icon.width != 0 ? tab.icon : (tab.is-drive ? IconMap.location-drive : IconMap.file-folder)); icon-size: 16px; }
                                Text { text: tab.title; color: VisualStyle.c303138; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                Text { visible: tab.loading && !(root.can-close-tab && tab-touch.has-hover); text: "…"; color: VisualStyle.c4f6bed; vertical-alignment: center; }
                                Rectangle {
                                    visible: root.can-close-tab && (tab-touch.has-hover || close-touch.has-hover);
                                    width: 24px; height: 34px;
                                    Rectangle {
                                        width: 24px; height: 24px; y: 5px; border-radius: 4px;
                                        background: close-touch.pressed ? VisualStyle.cd7dae0 : close-touch.has-hover ? VisualStyle.ce1e4ea : transparent;
                                        Image { width: 12px; height: 12px; x: 6px; y: 6px; source: IconMap.action-close; colorize: VisualStyle.c303138; }
                                    }
                                    close-touch := TouchArea { mouse-cursor: pointer; clicked => { root.close-tab(tab.id); } }
                                    accessible-role: button; accessible-label: root.text-close-tab;
                                }
                            }
                            Tooltip { text: @markdown("\{tab.title}"); }
                        }
                        }
                    }
                    }
                }
                Rectangle {
                    visible: root.tabs-overflow;
                    width: self.visible ? 28px : 0px; height: 34px; border-radius: 6px;
                    background: all-tabs-touch.pressed ? VisualStyle.cd9dce2 : all-tabs-touch.has-hover ? VisualStyle.ce8eaf0 : transparent;
                    Text { text: "⌄"; color: VisualStyle.c303138; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
                    all-tabs-touch := TouchArea { mouse-cursor: pointer; clicked => { root.tabs-menu-open = !root.tabs-menu-open; } }
                    accessible-role: button; accessible-label: root.text-all-tabs;
                    Tooltip { text: @markdown("\{root.text-all-tabs}"); }
                }
                Rectangle { width: 34px; height: 34px; border-radius: 6px; background: add-touch.pressed ? VisualStyle.cd9dce2 : add-touch.has-hover ? VisualStyle.ce8eaf0 : transparent; Image { width: 20px; height: 20px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; source: IconMap.action-add; colorize: VisualStyle.c303138; } add-touch := TouchArea { mouse-cursor: pointer; clicked => { root.new-tab(); } } accessible-role: button; accessible-label: root.text-new-tab; Tooltip { text: @markdown("\{root.text-new-tab} (Ctrl+T)"); } }
                Rectangle {
                    horizontal-stretch: 1;
                    drag-touch := TouchArea {
                        pointer-event(event) => { if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { root.drag-window(); } }
                        double-clicked => { root.maximized = !root.maximized; }
                    }
                }
            }
            HorizontalLayout {
                x: parent.width - 3 * 46px; y: 0px; width: 3 * 46px; height: 40px; spacing: 0px;
                WindowButton { kind: 0; label: root.text-window-minimize; clicked => { root.minimized = true; } }
                WindowButton { kind: 1; label: root.maximized ? root.text-window-restore : root.text-window-maximize; clicked => { root.maximized = !root.maximized; } }
                WindowButton { kind: 2; label: root.text-window-close; clicked => { root.request-close(); } }
            }
        }

        Rectangle {
            visible: !root.active-is-settings;
            height: self.visible ? 56px : 0px; background: VisualStyle.c323437; border-width: 0px;
            HorizontalLayout {
                padding-top: 9px; padding-bottom: 9px; padding-left: 14px; padding-right: 14px; spacing: 7px;
                ContextMenuArea { width: 38px; height: 38px; IconButton { icon-source: IconMap.action-back; tip: root.text-back + " (Alt+Left)"; enabled: root.can-navigate-back; button-label: root.text-back; clicked => { root.navigate-back(); } } Menu { for history in root.back-history: MenuItem { title: history.label; activated => { root.navigate-history(true, history.index); } } } }
                if !root.minimal: ContextMenuArea { width: 38px; height: 38px; IconButton { icon-source: IconMap.action-forward; tip: root.text-forward + " (Alt+Right)"; enabled: root.can-navigate-forward; button-label: root.text-forward; clicked => { root.navigate-forward(); } } Menu { for history in root.forward-history: MenuItem { title: history.label; activated => { root.navigate-history(false, history.index); } } } }
                if !root.compact: IconButton { icon-source: IconMap.action-up; tip: root.text-up + " (Alt+Up)"; enabled: root.can-navigate-up; button-label: root.text-up; clicked => { root.navigate-up(); } }
                if !root.compact: IconButton { icon-source: IconMap.action-refresh; tip: root.text-refresh + " (F5)"; enabled: root.can-refresh; button-label: root.text-refresh; clicked => { root.refresh(); } }
                Rectangle {
                    height: 38px; horizontal-stretch: 1; background: VisualStyle.cffffff; border-width: 0px; border-radius: 5px;
                    if !root.address-editing: Rectangle { x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px; HorizontalLayout { padding-left: 8px; padding-right: 8px; padding-top: 3px; padding-bottom: 3px; spacing: 2px; InlineIcon { icon-source: root.current-location-icon.width != 0 ? root.current-location-icon : (root.current-location-is-drive ? IconMap.location-drive : IconMap.file-folder); icon-size: 16px; } for crumb in root.breadcrumbs: BreadcrumbButton { label: crumb.label; current: crumb.current; clicked => { root.navigate-breadcrumb(crumb.index); } } Rectangle { horizontal-stretch: 1; TouchArea { mouse-cursor: pointer; clicked => { root.begin-address-edit(); } } } } }
                    address-editor := AddressEditor { visible: root.address-editing; x: 4px; y: 2px; width: parent.width - 8px; height: parent.height - 4px; text <=> root.address-input; address-label: root.text-address; cancel-label: root.text-cancel-edit; accepted(value) => { root.navigate-path(value); } cancelled => { root.cancel-address-edit(); } }

                }
                IconButton { icon-source: IconMap.action-forward; tip: root.text-go; button-label: root.text-go; clicked => { root.address-editing ? root.navigate-path(root.address-input) : root.begin-address-edit(); } }
            }
        }

        if !root.active-is-settings: HorizontalLayout {
            spacing: 0px;
            if !root.minimal: Rectangle {
                width: root.compact ? 184px : 218px; background: VisualStyle.c323437; border-width: 0px;
                VerticalLayout {
                    padding-top: 4px; padding-bottom: 12px; padding-left: 10px; padding-right: 10px; spacing: 0px;
                    SidebarGroupHeader { label: root.text-quick-access; expanded: root.quick-access-expanded; toggled => { root.quick-access-expanded = !root.quick-access-expanded; } }
                    for location in root.sidebar-items: Rectangle {
                        visible: !location.is-drive && root.quick-access-expanded;
                        height: self.visible ? 34px : 0px; border-radius: 5px; background: side-touch.pressed ? VisualStyle.cdde3ed : side-touch.has-hover ? VisualStyle.ce5e9f2 : transparent;
                        HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 10px; InlineIcon { icon-source: location.icon.width != 0 ? location.icon : (location.icon-kind == 0 ? IconMap.location-home : location.icon-kind == 1 ? IconMap.location-desktop : location.icon-kind == 2 ? IconMap.location-downloads : location.icon-kind == 3 ? IconMap.location-documents : location.icon-kind == 4 ? IconMap.location-pictures : location.icon-kind == 5 ? IconMap.location-music : IconMap.location-videos); } Text { text: location.label; color: VisualStyle.c4f535d; font-size: 13px; vertical-alignment: center; overflow: elide; } }
                        side-touch := TouchArea { mouse-cursor: pointer; clicked => { root.navigate-sidebar(location.index); } }
                        accessible-role: button; accessible-label: location.label;
                    }
                    SidebarGroupHeader { label: root.text-drives; expanded: root.drives-expanded; toggled => { root.drives-expanded = !root.drives-expanded; } }
                    for location in root.sidebar-items: Rectangle {
                        visible: location.is-drive && root.drives-expanded;
                        height: self.visible ? 34px : 0px; border-radius: 5px; background: drive-touch.pressed ? VisualStyle.cdde3ed : drive-touch.has-hover ? VisualStyle.ce5e9f2 : transparent;
                        HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 10px; InlineIcon { icon-source: location.icon.width != 0 ? location.icon : IconMap.location-drive; } Text { text: location.label; color: VisualStyle.c4f535d; font-size: 13px; vertical-alignment: center; overflow: elide; } }
                        drive-touch := TouchArea { mouse-cursor: pointer; clicked => { root.navigate-sidebar(location.index); } }
                        accessible-role: button; accessible-label: location.label;
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }

            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: 38px; background: VisualStyle.cffffff; border-width: 0px;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 44px; spacing: 12px;
                        for column in root.columns: Rectangle {
                            visible: true;
                            width: column.kind == 0 ? (root.compact ? 48% : 52%) : column.kind == 1 ? (root.compact ? 17% : 16%) : column.kind == 2 ? (root.compact ? 13% : 14%) : (root.compact ? 22% : 18%);
                            horizontal-stretch: column.kind == 3 ? 1 : 0;
                            opacity: column-touch.dragging ? 0.58 : 1;
                            Rectangle {
                                x: 0px; y: 10px; width: 1px; height: 18px;
                                background: VisualStyle.c57595c;
                            }
                            Text {
                                x: column.kind == 0 ? 27px : 8px;
                                width: parent.width - self.x;
                                horizontal-alignment: left;
                                text: (column.kind == 0 ? root.text-name : column.kind == 1 ? root.text-type : column.kind == 2 ? root.text-size : root.text-modified) + (root.sort-field == column.kind ? (root.sort-descending ? " ↓" : " ↑") : "");
                                color: VisualStyle.c696b74;
                                font-size: 12px; font-weight: root.sort-field == column.kind ? 600 : 400; vertical-alignment: center;
                            }
                            column-touch := TouchArea {
                                private property <length> press-x;
                                property <bool> dragging: false;
                                mouse-cursor: self.dragging ? grabbing : grab;
                                pointer-event(event) => {
                                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                        self.press-x = self.mouse-x;
                                        self.dragging = false;
                                    }
                                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && self.dragging {
                                        root.reorder-column(column.kind, self.mouse-x - self.press-x < -2 * parent.width ? -3 : self.mouse-x - self.press-x < -parent.width ? -2 : self.mouse-x - self.press-x < -8px ? -1 : self.mouse-x - self.press-x > 2 * parent.width ? 3 : self.mouse-x - self.press-x > parent.width ? 2 : 1);
                                    }
                                }
                                moved => { if self.pressed && abs(self.mouse-x - self.press-x) > 8px { self.dragging = true; } }
                                clicked => { if !self.dragging { root.change-sort(column.kind); } }
                            }
                        }
                    }
                }

                content-area := Rectangle {
                    vertical-stretch: 1; background: VisualStyle.cffffff;
                    background-touch := TouchArea {
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                                root.context-menu-anchor-x = self.absolute-position.x + self.mouse-x - root.absolute-position.x;
                                root.context-menu-anchor-y = self.absolute-position.y + self.mouse-y - root.absolute-position.y;
                                root.keyboard-menu-anchor-x = self.absolute-position.x + 24px - root.absolute-position.x;
                                root.keyboard-menu-anchor-y = self.absolute-position.y + 24px - root.absolute-position.y;
                                root.show-background-menu(
                                    root.context-menu-anchor-x / 1px,
                                    root.context-menu-anchor-y / 1px
                                );
                            }
                        }
                        clicked => { root.clear-selection(); }
                    }
                                        if root.rename-editing && root.rename-entry-id == -2: Rectangle {
                        x: 6px; y: 2px; width: parent.width - 40px; height: 40px; border-radius: 5px; background: VisualStyle.ceff4ff;
                        HorizontalLayout { padding-left: 10px; padding-right: 10px; spacing: 9px; InlineIcon { icon-source: IconMap.file-folder; } TextInput { text <=> root.rename-input; color: VisualStyle.c24252a; selection-background-color: VisualStyle.cc7d7ff; single-line: true; vertical-alignment: center; horizontal-stretch: 1; accepted => { root.commit-rename(root.rename-input); } key-pressed(event) => { if event.text == Key.Escape { root.cancel-rename(); return accept; } return reject; } accessible-label: root.rename-input; } }
                    }list := ListView {
                        visible: root.files.length > 0;
                        width: parent.width - 28px;
                        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                        for entry in root.files: Rectangle {
                            width: list.width;
                            height: 40px;
                            background: VisualStyle.cffffff;
                            Rectangle {
                                x: 6px; y: 2px; width: parent.width - 12px; height: parent.height - 4px;
                                border-radius: 5px;
                                border-width: 0px;
                                background: entry.selected ? VisualStyle.cdce6ff : (mouse.has-hover ? VisualStyle.ceff4ff : transparent);
                                HorizontalLayout {
                                    padding-left: 10px; padding-right: 10px; spacing: 12px;
                                for column in root.columns: Rectangle {
                                    visible: true;
                                    width: column.kind == 0 ? (root.compact ? 48% : 52%) : column.kind == 1 ? (root.compact ? 17% : 16%) : column.kind == 2 ? (root.compact ? 13% : 14%) : (root.compact ? 22% : 18%);
                                    horizontal-stretch: column.kind == 3 ? 1 : 0;
                                    if column.kind == 0: HorizontalLayout {
                                        width: parent.width;
                                        spacing: 9px;
                                        InlineIcon { icon-source: entry.icon.width != 0 ? entry.icon : (entry.is-directory ? IconMap.file-folder : IconMap.file-document); }
                                        if !(root.rename-editing && root.rename-entry-id == entry.id): Text { text: entry.name; color: VisualStyle.c24252a; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                        if root.rename-editing && root.rename-entry-id == entry.id: TextInput {
                                            text <=> root.rename-input;
                                            color: VisualStyle.c24252a;

                                            selection-background-color: VisualStyle.cc7d7ff;
                                            single-line: true;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            accepted => { root.commit-rename(root.rename-input); }
                                            key-pressed(event) => { if event.text == Key.Escape { root.cancel-rename(); return accept; } return reject; }
                                            accessible-label: entry.name;
                                        }
                                    }
                                    if column.kind != 0: Text {
                                        width: parent.width;
                                        text: column.kind == 1 ? entry.kind : column.kind == 2 ? entry.size : entry.modified;
                                        color: VisualStyle.c6f717a;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-alignment: column.kind == 2 ? right : left;
                                    }
                                }
                            }
                            }
                            mouse := TouchArea {
                                private property <bool> click-control: false;
                                private property <bool> click-shift: false;
                                mouse-cursor: pointer;
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.down {
                                        self.click-control = event.modifiers.control;
                                        self.click-shift = event.modifiers.shift;
                                        if event.button == PointerEventButton.right {
                                            root.context-menu-anchor-x = self.absolute-position.x + self.mouse-x - root.absolute-position.x;
                                            root.context-menu-anchor-y = self.absolute-position.y + self.mouse-y - root.absolute-position.y;
                                            root.keyboard-menu-anchor-x = root.context-menu-anchor-x;
                                            root.keyboard-menu-anchor-y = root.context-menu-anchor-y;
                                            root.show-entry-menu(
                                                entry.id,
                                                root.context-menu-anchor-x / 1px,
                                                root.context-menu-anchor-y / 1px
                                            );
                                        }
                                    }

                                }
                                clicked => { root.activate-entry(entry.id, self.click-control, self.click-shift); }
                            }
                            if entry.focused: Rectangle {
                                init => {
                                    root.keyboard-menu-anchor-x = parent.absolute-position.x + 32px - root.absolute-position.x;
                                    root.keyboard-menu-anchor-y = parent.absolute-position.y + parent.height / 2 - root.absolute-position.y;
                                }
                            }
                            accessible-role: list-item; accessible-label: entry.name;
                        }
                    }
                    LightScrollBar {
                        x: parent.width - self.width - 9px;
                        height: parent.height;
                        value <=> list.viewport-y;
                        maximum: max(0px, list.viewport-height - list.visible-height);
                        page-size: list.visible-height;
                    }
                    if root.page-state == 1 || root.page-state == 3: VerticalLayout {
                        alignment: center; spacing: 8px;
                        Text { text: root.page-state == 1 ? root.text-loading : root.text-empty-folder; color: VisualStyle.c62656f; font-size: 16px; horizontal-alignment: center; }
                    }
                    if root.page-state >= 5: VerticalLayout {
                        alignment: center; spacing: 12px;
                        HorizontalLayout { alignment: center; Image { width: 48px; height: 48px; source: IconMap.status-locked; } }
                        Text { text: root.error-page-title; color: VisualStyle.c30333a; font-size: 20px; font-weight: 600; horizontal-alignment: center; }
                        Text { text: root.error-page-description; color: VisualStyle.c62656f; font-size: 13px; horizontal-alignment: center; }
                        Rectangle { height: 4px; }
                        error-page-actions := Rectangle {
                            height: 32px;
                            accessible-role: groupbox;
                            accessible-id: "error-page-actions";
                            HorizontalLayout {
                                alignment: center; spacing: 8px;
                                if root.show-request-access: CommandButton { width: 196px; icon-source: IconMap.status-locked; label: root.text-request-access; clicked => { root.request-folder-access(); } }
                            }
                        }
                    }

                }

                Rectangle {
                    height: 30px; background: VisualStyle.cfafbfc; border-color: VisualStyle.ce7e8eb; border-width: 1px;
                    Text { x: 14px; text: root.status-text; color: VisualStyle.c72747d; font-size: 11px; vertical-alignment: center; }
                    Rectangle {
                        visible: root.operations.length > 0;
                        x: parent.width - 126px; width: 118px; height: 26px; y: 2px; border-radius: 5px;
                        background: task-touch.has-hover ? VisualStyle.cedf1f6 : transparent;
                        Text { text: root.operations.length + " " + root.text-task-count; color: VisualStyle.c30333a; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                        task-touch := TouchArea { clicked => { root.task-center-open = !root.task-center-open; } mouse-cursor: pointer; }
                        accessible-role: button; accessible-label: "File operations";
                    }
                }
            }
        }

        if root.active-is-settings: Rectangle {
            vertical-stretch: 1;
            background: VisualStyle.c323437;
            HorizontalLayout {
                padding-left: root.minimal ? 16px : 28px;
                padding-right: root.minimal ? 16px : 28px;
                padding-top: 24px;
                padding-bottom: 24px;
                spacing: root.minimal ? 16px : 28px;
                Rectangle {
                    width: root.minimal ? 150px : 236px;
                    background: VisualStyle.cfafbfc;
                    border-radius: 9px;
                    VerticalLayout {
                        padding-left: 12px; padding-right: 12px; padding-top: 18px; padding-bottom: 18px; spacing: 6px;
                        Text { text: root.text-settings-title; color: VisualStyle.c30333a; font-size: 22px; font-weight: 600; height: 42px; }
                        for section[index] in [root.text-settings-general, root.text-settings-appearance]: Rectangle {
                            height: 42px; border-radius: 6px;
                            background: root.settings-section == index ? VisualStyle.cdce6ff : (settings-nav-touch.has-hover ? VisualStyle.cedf1f6 : transparent);
                            Rectangle { visible: root.settings-section == index; x: 0px; y: 9px; width: 3px; height: 24px; border-radius: 2px; background: VisualStyle.c4f6bed; }
                            HorizontalLayout {
                                padding-left: 13px; padding-right: 10px; spacing: 10px;
                                InlineIcon { icon-source: index == 0 ? IconMap.action-language : IconMap.action-settings; icon-size: 18px; }
                                Text { text: section; color: VisualStyle.c30333a; font-size: 14px; vertical-alignment: center; overflow: elide; }
                            }
                            settings-nav-touch := TouchArea { mouse-cursor: pointer; clicked => { root.settings-section = index; } }
                            accessible-role: button; accessible-label: section;
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    background: VisualStyle.c323437;
                    settings-scroll := Flickable {
                        width: parent.width; height: parent.height;
                        viewport-width: self.width;
                        viewport-height: max(self.height, 188px);
                        VerticalLayout {
                            width: settings-scroll.width;
                            height: settings-scroll.viewport-height;
                            spacing: 16px;
                            Text { text: root.settings-section == 0 ? root.text-settings-general : root.text-settings-appearance; color: VisualStyle.c30333a; font-size: 22px; font-weight: 600; height: 44px; }
                            if root.settings-section == 0: Rectangle {
                                height: 112px; border-radius: 8px; border-width: 1px; border-color: VisualStyle.ce0e2e7; background: VisualStyle.cfafbfc;
                                VerticalLayout {
                                    padding-left: 20px; padding-right: 20px; padding-top: 16px; padding-bottom: 16px; spacing: 12px;
                                    Text { text: root.text-language; color: VisualStyle.c30333a; font-size: 15px; font-weight: 600; }
                                    HorizontalLayout {
                                        height: 42px; spacing: 8px;
                                        for language-option[index] in [root.text-language-chinese, root.text-language-english]: Rectangle {
                                            horizontal-stretch: 1; border-radius: 6px; border-width: root.language-mode == index ? 2px : 1px;
                                            border-color: root.language-mode == index ? VisualStyle.c4f6bed : VisualStyle.ce0e2e7;
                                            background: language-card-touch.pressed ? VisualStyle.cdde3ed : language-card-touch.has-hover ? VisualStyle.cedf1f6 : VisualStyle.cffffff;
                                            Text { text: language-option; color: VisualStyle.c30333a; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                                            language-card-touch := TouchArea { mouse-cursor: pointer; clicked => { root.change-language(index); } }
                                            accessible-role: button; accessible-label: language-option;
                                        }
                                    }
                                }
                            }
                            if root.settings-section == 1: Rectangle {
                                height: 112px; border-radius: 8px; border-width: 1px; border-color: VisualStyle.ce0e2e7; background: VisualStyle.cfafbfc;
                                VerticalLayout {
                                    padding-left: 20px; padding-right: 20px; padding-top: 16px; padding-bottom: 16px; spacing: 12px;
                                    Text { text: root.text-theme; color: VisualStyle.c30333a; font-size: 15px; font-weight: 600; }
                                    HorizontalLayout {
                                        height: 42px; spacing: 8px;
                                        for theme-option[index] in [root.text-theme-system, root.text-theme-light, root.text-theme-dark]: Rectangle {
                                            horizontal-stretch: 1; border-radius: 6px; border-width: root.theme-mode == index ? 2px : 1px;
                                            border-color: root.theme-mode == index ? VisualStyle.c4f6bed : VisualStyle.ce0e2e7;
                                            background: theme-card-touch.pressed ? VisualStyle.cdde3ed : theme-card-touch.has-hover ? VisualStyle.cedf1f6 : VisualStyle.cffffff;
                                            Text { text: theme-option; color: VisualStyle.c30333a; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                                            theme-card-touch := TouchArea { mouse-cursor: pointer; clicked => { root.change-theme(index); } }
                                            accessible-role: button; accessible-label: theme-option;
                                        }
                                    }
                                }
                            }
                            Rectangle { height: 16px; }
                        }
                    }
                }
            }
        }
    }

        if root.context-menu-open: TouchArea {
        z: 28; width: parent.width; height: parent.height;
        clicked => { root.context-menu-open = false; }
    }
    if root.context-menu-open: Rectangle {
        z: 29;
        x: min(
            max(12px, root.context-menu-anchor-x + self.width + 12px <= parent.width ? root.context-menu-anchor-x : root.context-menu-anchor-x - self.width),
            max(12px, parent.width - self.width - 12px)
        );
        y: min(
            max(12px, root.context-menu-anchor-y + self.height + 12px <= parent.height ? root.context-menu-anchor-y : root.context-menu-anchor-y - self.height),
            max(12px, parent.height - self.height - 12px)
        );
        width: 240px; height: 12px + root.context-commands.length * 36px;
        background: VisualStyle.cffffff; border-color: VisualStyle.ce0e2e7; border-width: 1px; border-radius: 7px;
        VerticalLayout { padding: 6px;
            for command in root.context-commands: Rectangle {
                height: 36px; border-radius: 5px;
                background: command.enabled && command-touch.has-hover ? VisualStyle.cedf1f6 : transparent;
                Rectangle { visible: command.separator; x: 4px; width: parent.width - 8px; height: 1px; y: 17px; background: VisualStyle.ce0e2e7; }
                Text { visible: !command.separator; x: 10px; text: command.label; color: command.enabled ? VisualStyle.c30333a : VisualStyle.c9a9da3; font-size: 12px; vertical-alignment: center; }
                command-touch := TouchArea { enabled: command.enabled && !command.separator; clicked => { root.context-menu-open = false; root.invoke-context-command(command.id); } }
                accessible-role: button; accessible-label: command.label; accessible-enabled: command.enabled;
            }
        }
    }
    if root.task-center-open: TouchArea { z: 30; width: parent.width; height: parent.height; clicked => { root.task-center-open = false; } }
    if root.task-center-open: Rectangle {
        z: 31; x: parent.width - 390px; y: 50px; width: 374px; height: min(parent.height - 70px, 80px + root.operations.length * 82px);
        background: VisualStyle.cffffff; border-color: VisualStyle.ce0e2e7; border-width: 1px; border-radius: 8px;
        VerticalLayout { padding: 12px; spacing: 8px;
            Text { text: root.text-file-operations; color: VisualStyle.c30333a; font-size: 16px; font-weight: 600; height: 26px; }
            Text { visible: root.operation-error != ""; text: root.operation-error; color: #b3261e; font-size: 11px; wrap: word-wrap; }
            for operation in root.operations: Rectangle {
                height: 74px; background: VisualStyle.cfafbfc; border-radius: 6px; border-width: 1px; border-color: VisualStyle.ce0e2e7;
                VerticalLayout { padding: 8px; spacing: 4px;
                    HorizontalLayout { Text { text: operation.title; color: VisualStyle.c30333a; font-size: 12px; font-weight: 600; horizontal-stretch: 1; } Text { text: operation.detail; color: VisualStyle.c72747d; font-size: 11px; } }
                    Rectangle { height: 5px; border-radius: 3px; background: VisualStyle.ce0e2e7; Rectangle { width: max(0px, min(parent.width, parent.width * operation.progress)); height: parent.height; border-radius: 3px; background: VisualStyle.c4f6bed; } }
                    HorizontalLayout { Rectangle { horizontal-stretch: 1; } CommandButton { visible: operation.can-cancel; width: 68px; label: root.text-cancel-operation; clicked => { root.cancel-operation(operation.id); } } CommandButton { visible: operation.can-retry; width: 68px; label: root.text-retry-operation; clicked => { root.retry-operation(operation.id); } } }
                }
            }
        }
    }
    if root.confirm-permanent-delete-open || root.exit-prompt-open || root.conflict-prompt-open: TouchArea { z: 38; width: parent.width; height: parent.height; }
    if root.conflict-prompt-open: Rectangle {
        z: 39; x: (parent.width - 520px) / 2; y: (parent.height - 240px) / 2; width: 520px; height: 240px; background: VisualStyle.cffffff; border-radius: 9px; border-width: 1px; border-color: VisualStyle.ce0e2e7;
        VerticalLayout {
            padding: 20px; spacing: 10px;
            Text { text: root.text-conflict-title; color: VisualStyle.c30333a; font-size: 18px; font-weight: 600; }
            Text { text: root.text-conflict-detail; color: VisualStyle.c62656f; font-size: 13px; }
            Text { text: root.conflict-source; color: VisualStyle.c30333a; font-size: 12px; overflow: elide; }
            Text { text: root.conflict-destination; color: VisualStyle.c62656f; font-size: 12px; overflow: elide; }
            CommandButton { width: 280px; label: (root.conflict-apply-all ? "☑ " : "☐ ") + root.text-apply-all; clicked => { root.conflict-apply-all = !root.conflict-apply-all; } }
            HorizontalLayout {
                alignment: end; spacing: 8px;
                CommandButton { width: 96px; label: root.text-skip; clicked => { root.resolve-conflict(1, root.conflict-apply-all); } }
                CommandButton { width: 108px; label: root.text-keep-both; clicked => { root.resolve-conflict(2, root.conflict-apply-all); } }
                CommandButton { width: 96px; label: root.text-replace; clicked => { root.resolve-conflict(0, root.conflict-apply-all); } }
            }
        }
    }
    if root.confirm-permanent-delete-open: Rectangle {
        z: 39; x: (parent.width - 420px) / 2; y: (parent.height - 170px) / 2; width: 420px; height: 170px; background: VisualStyle.cffffff; border-radius: 9px; border-width: 1px; border-color: VisualStyle.ce0e2e7;
        VerticalLayout { padding: 20px; spacing: 12px; Text { text: root.text-permanent-delete-title; color: VisualStyle.c30333a; font-size: 18px; font-weight: 600; } Text { text: root.text-permanent-delete-detail; color: VisualStyle.c62656f; font-size: 13px; } HorizontalLayout { alignment: end; spacing: 8px; CommandButton { label: root.text-cancel-operation; clicked => { root.cancel-permanent-delete(); } } CommandButton { label: root.text-delete; clicked => { root.confirm-permanent-delete(); } } } }
    }
    if root.exit-prompt-open: Rectangle {
        z: 39; x: (parent.width - 460px) / 2; y: (parent.height - 186px) / 2; width: 460px; height: 186px; background: VisualStyle.cffffff; border-radius: 9px; border-width: 1px; border-color: VisualStyle.ce0e2e7;
        VerticalLayout { padding: 20px; spacing: 12px; Text { text: root.text-exit-title; color: VisualStyle.c30333a; font-size: 18px; font-weight: 600; } Text { text: root.text-exit-detail; color: VisualStyle.c62656f; font-size: 13px; } HorizontalLayout { alignment: end; spacing: 8px; CommandButton { width: 150px; label: root.text-cancel-and-exit; clicked => { root.cancel-tasks-and-close(); } } CommandButton { width: 120px; label: root.text-wait; clicked => { root.wait-on-close(); } } } }
    }
if root.tabs-menu-open: TouchArea {
        z: 19;
        width: parent.width;
        height: parent.height;
        clicked => { root.tabs-menu-open = false; }
    }

    if root.tabs-menu-open: Rectangle {
        x: max(8px, parent.width - 3 * 46px - 270px); y: 46px;
        width: 260px; height: min(354px, 12px + min(root.tabs.length, 9) * 38px); z: 20;
        background: VisualStyle.cffffff; border-color: VisualStyle.ce0e2e7; border-width: 1px; border-radius: 7px;
        clip: true;
        ListView {
            x: 6px; y: 6px; width: parent.width - 12px; height: parent.height - 12px;
            vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
            for tab[index] in root.tabs: Rectangle {
                height: 38px; border-radius: 5px;
                background: tab.active ? VisualStyle.cdce6ff : (tabs-menu-touch.has-hover ? VisualStyle.cedf1f6 : transparent);
                HorizontalLayout {
                    padding-left: 8px; padding-right: 8px; spacing: 8px;
                    InlineIcon { icon-source: tab.is-settings ? IconMap.action-settings : (tab.icon.width != 0 ? tab.icon : (tab.is-drive ? IconMap.location-drive : IconMap.file-folder)); icon-size: 16px; }
                    Text { text: tab.title; color: VisualStyle.c303138; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; font-weight: tab.active ? 600 : 400; }
                }
                tabs-menu-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.tabs-menu-open = false; root.activate-tab(tab.id); root.reveal-tab(index); }
                }
                accessible-role: button; accessible-label: tab.title;
            }
        }
    }
    if root.menu-open: TouchArea {
        z: 19;
        width: parent.width;
        height: parent.height;
        clicked => { root.menu-open = false; }
    }

    if root.menu-open: Rectangle {
        x: 8px; y: 46px; width: 190px; height: 54px; z: 20;
        background: VisualStyle.cffffff; border-color: VisualStyle.ce0e2e7; border-width: 1px; border-radius: 7px;
        Rectangle {
            x: 6px; y: 6px; width: parent.width - 12px; height: 42px; border-radius: 5px;
            background: settings-menu-touch.pressed ? VisualStyle.cdde3ed : settings-menu-touch.has-hover ? VisualStyle.cedf1f6 : transparent;
            HorizontalLayout {
                padding-left: 10px; padding-right: 10px; spacing: 10px;
                Rectangle {
                    width: 18px; height: parent.height;
                    Image {
                        width: 18px; height: 18px;
                        y: (parent.height - self.height) / 2;
                        source: IconMap.action-settings;
                        colorize: VisualStyle.c303138;
                    }
                }
                Text { text: root.text-settings; color: VisualStyle.c30333a; font-size: 13px; vertical-alignment: center; }
            }
            settings-menu-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.menu-open = false; root.open-settings(); }
            }
            accessible-role: button; accessible-label: root.text-settings;
        }
    }

    if root.address-editing && !root.active-is-settings: Rectangle {
        y: 0px;
        width: parent.width;
        height: 59px;
        TouchArea { clicked => { root.cancel-address-edit(); } }
    }
    if root.address-editing && !root.active-is-settings: Rectangle {
        x: 0px;
        y: 59px;
        width: 59px + (!root.minimal ? 45px : 0px) + (!root.compact ? 90px : 0px);
        height: 38px;
        TouchArea { clicked => { root.cancel-address-edit(); } }
    }
    if root.address-editing && !root.active-is-settings: Rectangle {
        x: parent.width - 59px - (!root.minimal ? 45px : 0px);
        y: 59px;
        width: 59px + (!root.minimal ? 45px : 0px);
        height: 38px;
        TouchArea { clicked => { root.cancel-address-edit(); } }
    }
    if root.address-editing && !root.active-is-settings: Rectangle {
        y: 97px;
        width: parent.width;
        height: parent.height - self.y;
        TouchArea { clicked => { root.cancel-address-edit(); } }
    }
    }
}
