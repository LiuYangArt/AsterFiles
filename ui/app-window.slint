import { ListView } from "std-widgets.slint";
import { IconMap } from "icons/icon-map.slint";

export struct FileRow { id: int, name: string, kind: string, size: string, modified: string, is-directory: bool, selected: bool, focused: bool, icon: image }
export struct HistoryRow { index: int, label: string }
export struct BreadcrumbRow { index: int, label: string, current: bool }
export struct TabRow { id: int, title: string, active: bool, loading: bool, icon: image, is-drive: bool, is-settings: bool }
export struct SidebarRow { index: int, label: string, icon-kind: int, is-drive: bool, icon: image }
export struct ColumnRow { kind: int }
export struct ContextCommandRow { id: int, label: string, enabled: bool, separator: bool }
export struct OperationRow { id: int, title: string, detail: string, progress: float, state: int, can-cancel: bool, can-retry: bool }
export global VisualStyle {
    in-out property <bool> dark-theme: false;
    out property <color> c24252a: dark-theme ? #f2f2f2 : #24252a;
    out property <color> c303138: dark-theme ? #f2f2f2 : #303138;
    out property <color> c30333a: dark-theme ? #f2f2f2 : #30333a;
    out property <color> c323437: #323437;
    out property <color> c57595c: dark-theme ? #57595c : #75787c;
    out property <color> c3b4f83: dark-theme ? #9db5ff : #3b4f83;
    out property <color> c4f535d: dark-theme ? #d0d0d0 : #4f535d;
    out property <color> c4f6bed: dark-theme ? #7fa0ff : #4f6bed;
    out property <color> c62656f: dark-theme ? #c6c6c6 : #62656f;
    out property <color> c666a74: dark-theme ? #bcbcbc : #666a74;
    out property <color> c696b74: dark-theme ? #bdbdbd : #696b74;
    out property <color> c6f717a: dark-theme ? #bdbdbd : #6f717a;
    out property <color> c72747d: dark-theme ? #a9a9a9 : #72747d;
    out property <color> c777a84: dark-theme ? #b0b0b0 : #777a84;
    out property <color> c777b85: dark-theme ? #b0b0b0 : #777b85;
    out property <color> c9a9da3: dark-theme ? #8a8a8a : #9a9da3;
    out property <color> caeb1b6: dark-theme ? #737373 : #aeb1b6;
    out property <color> cc42b1c: #c42b1c;
    out property <color> cc7d7ff: dark-theme ? #35548f : #c7d7ff;
    out property <color> cd7dae0: dark-theme ? #4a4a4a : #d7dae0;
    out property <color> cd7dce5: dark-theme ? #4a4a4a : #d7dce5;
    out property <color> cd9dce2: dark-theme ? #454545 : #d9dce2;
    out property <color> cdce6ff: dark-theme ? #263d66 : #dce6ff;
    out property <color> cdde3ed: dark-theme ? #464646 : #dde3ed;
    out property <color> ce0e2e7: dark-theme ? #4b4b4b : #e0e2e7;
    out property <color> ce1e4ea: dark-theme ? #4c4c4c : #e1e4ea;
    out property <color> ce2e3e7: dark-theme ? #484848 : #e2e3e7;
    out property <color> ce2e4e9: dark-theme ? #444444 : #e2e4e9;
    out property <color> ce3e7ef: dark-theme ? #424242 : #e3e7ef;
    out property <color> ce5e9f2: dark-theme ? #414141 : #e5e9f2;
    out property <color> ce7e8eb: dark-theme ? #404040 : #e7e8eb;
    out property <color> ce8eaf0: dark-theme ? #3d3d3d : #e8eaf0;
    out property <color> cedf1f6: dark-theme ? #424242 : #edf1f6;
    out property <color> ceff4ff: dark-theme ? #303b4d : #eff4ff;
    out property <color> cf1f2f4: dark-theme ? #343434 : #f1f2f4;
    out property <color> cf1f2f5: dark-theme ? #292929 : #f1f2f5;
    out property <color> cf5f6f8: dark-theme ? #202020 : #f5f6f8;
    out property <color> cf8f8f9: dark-theme ? #303030 : #f8f8f9;
    out property <color> cfafbfc: dark-theme ? #272727 : #fafbfc;
    out property <color> cffffff: dark-theme ? #252525 : #ffffff;
}

component InlineIcon inherits Rectangle {
    in property <image> icon-source;
    in property <length> icon-size: 18px;
    width: root.icon-size;
    Image { width: root.icon-size; height: root.icon-size; y: (parent.height - self.height) / 2; source: root.icon-source; }
}

component IconButton inherits Rectangle {
    in property <image> icon-source;
    in property <string> tip;
    in property <string> button-label: root.tip;
    in property <bool> enabled: true;
    callback clicked();
    width: 38px;
    height: 38px;
    border-radius: 5px;
    border-width: 0px;
    background: !root.enabled ? transparent : icon-touch.pressed ? VisualStyle.cdde3ed : icon-touch.has-hover ? VisualStyle.cedf1f6 : transparent;
    opacity: root.enabled ? 1 : 0.46;
    Image {
        width: 20px;
        height: 20px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon-source;
        image-fit: contain;
        colorize: VisualStyle.c303138;
    }
    icon-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    accessible-role: button;
    accessible-label: root.button-label;
    accessible-enabled: root.enabled;
    Tooltip { text: @markdown("\{root.tip}"); }
}

component CommandButton inherits Rectangle {
    in property <image> icon-source;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();
    width: 76px;
    height: 32px;
    horizontal-stretch: 0;
    border-radius: 5px;
    border-width: 1px;
    border-color: VisualStyle.ce0e2e7;
    background: !root.enabled ? VisualStyle.cf8f8f9 : command-touch.pressed ? VisualStyle.cdde3ed : command-touch.has-hover ? VisualStyle.cedf1f6 : VisualStyle.cffffff;
    opacity: root.enabled ? 1 : 0.5;
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 6px;
        InlineIcon { icon-source: root.icon-source; icon-size: 16px; }
        Text { text: root.label; color: VisualStyle.c30333a; font-size: 12px; vertical-alignment: center; }
    }
    command-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
}

component SidebarGroupHeader inherits Rectangle {
    in property <string> label;
    in property <bool> expanded: true;
    callback toggled();
    height: 30px;
    background: group-touch.has-hover ? VisualStyle.ce5e9f2 : transparent;
    border-radius: 5px;
    HorizontalLayout {
        padding-left: 7px; padding-right: 7px; spacing: 7px;
        Rectangle {
            width: 12px; height: parent.height;
            Path {
                x: 2px; y: (parent.height - self.height) / 2; width: 8px; height: 8px;
                viewbox-width: 8; viewbox-height: 8; fit: fill;
                commands: root.expanded ? "M 1 2.5 L 4 5.5 L 7 2.5" : "M 2.5 1 L 5.5 4 L 2.5 7";
                stroke: VisualStyle.c666a74; stroke-width: 1.2px; stroke-line-cap: round; stroke-line-join: round; fill: transparent;
            }
        }
        Text { text: root.label; color: VisualStyle.c777a84; font-size: 12px; font-weight: 700; vertical-alignment: center; }
    }
    group-touch := TouchArea { mouse-cursor: pointer; clicked => { root.toggled(); } }
    accessible-role: button;
    accessible-label: root.label;
}

component WindowButton inherits Rectangle {
    in property <int> kind;
    in property <string> label;
    callback clicked();
    width: 46px;
    height: 40px;
    background: root.kind == 2 && button-touch.has-hover ? VisualStyle.cc42b1c : button-touch.pressed ? VisualStyle.cd9dce2 : button-touch.has-hover ? VisualStyle.ce8eaf0 : transparent;
    Rectangle {
        visible: root.kind == 0;
        width: 10px; height: 1px;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        background: root.kind == 2 && button-touch.has-hover ? VisualStyle.cffffff : VisualStyle.c303138;
    }
    Rectangle {
        visible: root.kind == 1;
        width: 9px; height: 9px;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        border-width: 1px;
        border-color: VisualStyle.c303138;
        background: transparent;
    }
    Image {
        visible: root.kind == 2;
        width: 14px; height: 14px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: button-touch.has-hover ? IconMap.action-close-hover : IconMap.action-close;
        colorize: button-touch.has-hover ? #ffffff : VisualStyle.c303138;
    }
    button-touch := TouchArea { clicked => { root.clicked(); } }
    accessible-role: button;
    accessible-label: root.label;
}

component LightScrollBar inherits Rectangle {
    in-out property <length> value;
    in property <length> maximum;
    in property <length> page-size;
    callback scrolled();

    width: 12px;
    visible: root.maximum > 0px;
    background: scroll-touch.has-hover ? VisualStyle.cf1f2f4 : transparent;
    border-radius: 6px;

    private property <length> track-padding: 4px;
    private property <length> track-height: root.height - 2 * root.track-padding;
    private property <length> thumb-height: max(28px, root.track-height * root.page-size / (root.maximum + root.page-size));
    private property <length> thumb-travel: max(0px, root.track-height - root.thumb-height);

    thumb := Rectangle {
        width: scroll-touch.has-hover ? 6px : 3px;
        height: root.thumb-height;
        x: parent.width - self.width - 3px;
        y: root.track-padding + root.thumb-travel * (-root.value / root.maximum);
        border-radius: self.width / 2;
        background: scroll-touch.has-hover ? VisualStyle.c9a9da3 : VisualStyle.caeb1b6;
    }

    scroll-touch := TouchArea {
        property <length> press-value;
        property <length> press-y;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                self.press-value = root.value;
                self.press-y = self.mouse-y;
            }
        }
        moved => {
            if self.pressed && root.thumb-travel > 0px {
                root.value = max(-root.maximum, min(0px, self.press-value - (self.mouse-y - self.press-y) * root.maximum / root.thumb-travel));
                root.scrolled();
            }
        }
    }
}

component BreadcrumbButton inherits Rectangle {
    in property <string> label;
    in property <bool> current: false;
    callback clicked();
    min-width: 42px;
    height: 30px;
    border-radius: 4px;
    background: !root.current && crumb-touch.has-hover ? VisualStyle.cedf1f6 : transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 5px;
        Text { text: root.label; color: VisualStyle.c30333a; font-size: 12px; font-weight: root.current ? 600 : 400; vertical-alignment: center; }
        Text { visible: !root.current; text: "›"; color: VisualStyle.c777b85; font-size: 14px; vertical-alignment: center; }
    }
    crumb-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: true;
}

component AddressEditor inherits Rectangle {
    in-out property <string> text;
    in property <bool> has-error: false;
    in property <string> address-label;
    in property <string> cancel-label;
    callback accepted(string);
    callback cancelled();

    public function focus-and-select-all() {
        editor.focus();
        editor.select-all();
    }

    background: VisualStyle.cffffff;
    forward-focus: editor;
    property <bool> editor-has-focus: editor.has-focus;

    changed editor-has-focus => {
        if root.visible && !root.editor-has-focus {
            root.cancelled();
        }
    }

    editor := TextInput {
        x: 8px;
        width: parent.width - 38px;
        height: parent.height;
        text <=> root.text;
        color: VisualStyle.c30333a;
        selection-background-color: VisualStyle.cc7d7ff;
        selection-foreground-color: VisualStyle.c24252a;
        font-size: 13px;
        single-line: true;
        vertical-alignment: center;
        accessible-role: text-input;
        accessible-label: root.address-label;
        accepted => { root.accepted(root.text); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancelled();
                return accept;
            }
            return reject;
        }
    }


    Rectangle {
        x: parent.width - 30px;
        width: 30px;
        height: parent.height;
        border-radius: 4px;
        background: dismiss-touch.pressed ? VisualStyle.cdde3ed : dismiss-touch.has-hover ? VisualStyle.cedf1f6 : transparent;
        Image {
            width: 16px;
            height: 16px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            source: IconMap.action-close;
            colorize: VisualStyle.c303138;
        }
        dismiss-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.cancelled(); }
        }
        accessible-role: button;
        accessible-label: root.cancel-label;
    }
}

