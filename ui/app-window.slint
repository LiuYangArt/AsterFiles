import { ListView } from "std-widgets.slint";

export struct FileRow { id: int, name: string, kind: string, size: string, modified: string, is-directory: bool, selected: bool, focused: bool }
export struct HistoryRow { index: int, label: string }
export struct BreadcrumbRow { index: int, label: string, current: bool }
export struct TabRow { id: int, title: string, active: bool, loading: bool }
export struct SidebarRow { index: int, label: string, icon-kind: int, selected: bool, is-drive: bool }
export struct ColumnRow { kind: int }

component InlineIcon inherits Rectangle {
    in property <image> icon-source;
    in property <length> icon-size: 18px;
    width: root.icon-size;
    Image { width: root.icon-size; height: root.icon-size; y: (parent.height - self.height) / 2; source: root.icon-source; }
}

component IconButton inherits Rectangle {
    in property <image> icon-source;
    in property <string> tip;
    in property <string> button-label: root.tip;
    in property <bool> enabled: true;
    callback clicked();
    width: 38px;
    height: 38px;
    border-radius: 5px;
    border-width: 1px;
    border-color: #e0e2e7;
    background: !root.enabled ? #f8f8f9 : icon-touch.pressed ? #dde3ed : icon-touch.has-hover ? #edf1f6 : #ffffff;
    opacity: root.enabled ? 1 : 0.46;
    Image {
        width: 20px;
        height: 20px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon-source;
        image-fit: contain;
    }
    icon-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    accessible-role: button;
    accessible-label: root.button-label;
    accessible-enabled: root.enabled;
    Tooltip { text: @markdown("\{root.tip}"); }
}

component CommandButton inherits Rectangle {
    in property <image> icon-source;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();
    width: 76px;
    height: 32px;
    horizontal-stretch: 0;
    border-radius: 5px;
    border-width: 1px;
    border-color: #e0e2e7;
    background: !root.enabled ? #f8f8f9 : command-touch.pressed ? #dde3ed : command-touch.has-hover ? #edf1f6 : #ffffff;
    opacity: root.enabled ? 1 : 0.5;
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 6px;
        InlineIcon { icon-source: root.icon-source; icon-size: 16px; }
        Text { text: root.label; color: #30333a; font-size: 12px; vertical-alignment: center; }
    }
    command-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
}

component SidebarGroupHeader inherits Rectangle {
    in property <string> label;
    in property <bool> expanded: true;
    callback toggled();
    height: 30px;
    background: group-touch.has-hover ? #e5e9f2 : transparent;
    border-radius: 5px;
    HorizontalLayout {
        padding-left: 7px; padding-right: 7px; spacing: 7px;
        Text { text: root.expanded ? "⌄" : "›"; width: 12px; color: #666a74; font-size: 14px; vertical-alignment: center; horizontal-alignment: center; }
        Text { text: root.label; color: #777a84; font-size: 12px; font-weight: 700; vertical-alignment: center; }
    }
    group-touch := TouchArea { mouse-cursor: pointer; clicked => { root.toggled(); } }
    accessible-role: button;
    accessible-label: root.label;
}

component WindowButton inherits Rectangle {
    in property <int> kind;
    in property <string> label;
    callback clicked();
    width: 46px;
    height: 40px;
    background: root.kind == 2 && button-touch.has-hover ? #c42b1c : button-touch.pressed ? #d9dce2 : button-touch.has-hover ? #e8eaf0 : transparent;
    Rectangle {
        visible: root.kind == 0;
        width: 10px; height: 1px;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        background: root.kind == 2 && button-touch.has-hover ? #ffffff : #303138;
    }
    Rectangle {
        visible: root.kind == 1;
        width: 9px; height: 9px;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        border-width: 1px;
        border-color: #303138;
        background: transparent;
    }
    Image {
        visible: root.kind == 2;
        width: 14px; height: 14px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: button-touch.has-hover ? @image-url("icons/actions/close-white.svg") : @image-url("icons/actions/close.svg");
    }
    button-touch := TouchArea { clicked => { root.clicked(); } }
    accessible-role: button;
    accessible-label: root.label;
}

component LightScrollBar inherits Rectangle {
    in-out property <length> value;
    in property <length> maximum;
    in property <length> page-size;
    callback scrolled();

    width: 12px;
    visible: root.maximum > 0px;
    background: scroll-touch.has-hover ? #f1f2f4 : transparent;
    border-radius: 6px;

    private property <length> track-padding: 4px;
    private property <length> track-height: root.height - 2 * root.track-padding;
    private property <length> thumb-height: max(28px, root.track-height * root.page-size / (root.maximum + root.page-size));
    private property <length> thumb-travel: max(0px, root.track-height - root.thumb-height);

    thumb := Rectangle {
        width: scroll-touch.has-hover ? 6px : 3px;
        height: root.thumb-height;
        x: parent.width - self.width - 3px;
        y: root.track-padding + root.thumb-travel * (-root.value / root.maximum);
        border-radius: self.width / 2;
        background: scroll-touch.has-hover ? #9a9da3 : #aeb1b6;
    }

    scroll-touch := TouchArea {
        property <length> press-value;
        property <length> press-y;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                self.press-value = root.value;
                self.press-y = self.mouse-y;
            }
        }
        moved => {
            if self.pressed && root.thumb-travel > 0px {
                root.value = max(-root.maximum, min(0px, self.press-value - (self.mouse-y - self.press-y) * root.maximum / root.thumb-travel));
                root.scrolled();
            }
        }
    }
}

component BreadcrumbButton inherits Rectangle {
    in property <string> label;
    in property <bool> current: false;
    callback clicked();
    min-width: 42px;
    height: 30px;
    border-radius: 4px;
    background: !root.current && crumb-touch.has-hover ? #edf1f6 : transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 5px;
        Text { text: root.label; color: #30333a; font-size: 12px; font-weight: root.current ? 600 : 400; vertical-alignment: center; }
        Text { visible: !root.current; text: "›"; color: #777b85; font-size: 14px; vertical-alignment: center; }
    }
    crumb-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: true;
}

component AddressEditor inherits Rectangle {
    in-out property <string> text;
    in property <bool> has-error: false;
    callback accepted(string);
    callback cancelled();

    public function focus-and-select-all() {
        editor.focus();
        editor.select-all();
    }

    background: #ffffff;
    forward-focus: editor;
    property <bool> editor-has-focus: editor.has-focus;

    changed editor-has-focus => {
        if root.visible && !root.editor-has-focus {
            root.cancelled();
        }
    }

    editor := TextInput {
        x: 8px;
        width: parent.width - 38px;
        height: parent.height;
        text <=> root.text;
        color: #30333a;
        selection-background-color: #c7d7ff;
        selection-foreground-color: #24252a;
        font-size: 13px;
        single-line: true;
        vertical-alignment: center;
        accessible-role: text-input;
        accessible-label: "路径";
        accepted => { root.accepted(root.text); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancelled();
                return accept;
            }
            return reject;
        }
    }


    Rectangle {
        x: parent.width - 30px;
        width: 30px;
        height: parent.height;
        border-radius: 4px;
        background: dismiss-touch.pressed ? #dde3ed : dismiss-touch.has-hover ? #edf1f6 : transparent;
        Image {
            width: 16px;
            height: 16px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            source: @image-url("icons/actions/close.svg");
        }
        dismiss-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.cancelled(); }
        }
        accessible-role: button;
        accessible-label: "取消编辑";
    }
}

export component AppWindow inherits Window {
    title: "AsterFiles";
    icon: @image-url("../assets/app-icon.png");
    no-frame: true;
    resize-border-width: 10px;
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 820px;
    min-height: 520px;
    background: #f5f6f8;
    in property <length> window-width: 1180px;
    default-font-family: "Segoe UI";

    in property <string> current-path: "C:\\";
    in-out property <string> address-input: "C:\\";
    in property <bool> address-editing: false;


    in property <string> status-text: "";
    in property <string> error-page-title: "";
    in property <string> error-page-description: "";
    in property <string> text-request-access: "使用 Windows 请求访问权限";
    in property <bool> show-request-access: false;


    in property <[FileRow]> files;
    in property <[TabRow]> tabs;
    in property <[HistoryRow]> back-history;
    in property <[HistoryRow]> forward-history;
    in property <[BreadcrumbRow]> breadcrumbs;
    in property <[SidebarRow]> sidebar-items;
    in property <[ColumnRow]> columns;
    in-out property <bool> quick-access-expanded: true;
    in-out property <bool> drives-expanded: true;
    in property <bool> can-navigate-back: false;
    in property <bool> can-navigate-forward: false;
    in property <bool> can-navigate-up: false;
    in property <bool> can-refresh: false;
    in property <bool> can-close-tab: false;
    in property <bool> can-restore-tab: false;
    in property <int> selected-count: 0;
    in property <int> sort-field: 0;
    in property <bool> sort-descending: false;
    in property <int> page-state: 0;
    in property <string> language-label: "EN";
    in property <string> text-go: "前往";
    in property <string> text-back: "后退";
    in property <string> text-forward: "前进";
    in property <string> text-up: "向上";
    in property <string> text-refresh: "刷新";
    in property <string> text-home: "常用位置";
    in property <string> text-desktop: "桌面";
    in property <string> text-downloads: "下载";
    in property <string> text-documents: "文档";
    in property <string> text-pictures: "图片";
    in property <string> text-music: "音乐";
    in property <string> text-videos: "视频";
    in property <string> text-quick-access: "快速访问";
    in property <string> text-drives: "磁盘";
    in property <string> text-name: "名称";
    in property <string> text-type: "类型";
    in property <string> text-modified: "修改时间";
    in property <string> text-size: "大小";

    callback navigate-path(string);
    callback begin-address-edit();
    callback cancel-address-edit();
    callback navigate-back();
    callback navigate-forward();
    callback navigate-history(bool, int);
    callback navigate-up();
    callback refresh();
    callback request-folder-access();

    callback navigate-sidebar(int);
    callback navigate-breadcrumb(int);
    callback select-entry(int, bool, bool);
    callback clear-selection();
    callback select-all();
    callback move-focus(int, bool);
    callback focus-boundary(bool, bool);
    callback toggle-focused();
    callback change-sort(int);
    callback reorder-column(int, int);
    callback open-entry(int);
    callback activate-entry(int, bool, bool);
    callback new-tab();
    callback close-tab(int);
    callback restore-tab();
    callback activate-tab(int);
    callback toggle-language();
    callback drag-window();

    private property <bool> compact: root.window-width < 1000px;
    private property <bool> minimal: root.window-width < 900px;

    public function focus-address-editor() { address-editor.focus-and-select-all(); }

    forward-focus: shortcut-handler;
    shortcut-handler := FocusScope {
        width: parent.width;
        height: parent.height;
        KeyBinding { keys: @keys(Alt + LeftArrow); enabled: root.can-navigate-back; activated => { root.navigate-back(); } }
        KeyBinding { keys: @keys(Alt + RightArrow); enabled: root.can-navigate-forward; activated => { root.navigate-forward(); } }
        KeyBinding { keys: @keys(Alt + UpArrow); enabled: root.can-navigate-up; activated => { root.navigate-up(); } }
        KeyBinding { keys: @keys(F5); enabled: root.can-refresh; activated => { root.refresh(); } }
        KeyBinding { keys: @keys(Control + R); enabled: root.can-refresh; activated => { root.refresh(); } }
        KeyBinding { keys: @keys(Control + L); activated => { root.begin-address-edit(); } }
        KeyBinding { keys: @keys(Alt + D); activated => { root.begin-address-edit(); } }
        KeyBinding { keys: @keys(Control + A); enabled: !root.address-editing; activated => { root.select-all(); } }
        KeyBinding { keys: @keys(Control + Space); enabled: !root.address-editing; activated => { root.toggle-focused(); } }
        KeyBinding { keys: @keys(UpArrow); enabled: !root.address-editing; activated => { root.move-focus(-1, false); } }
        KeyBinding { keys: @keys(DownArrow); enabled: !root.address-editing; activated => { root.move-focus(1, false); } }
        KeyBinding { keys: @keys(Shift + UpArrow); enabled: !root.address-editing; activated => { root.move-focus(-1, true); } }
        KeyBinding { keys: @keys(Shift + DownArrow); enabled: !root.address-editing; activated => { root.move-focus(1, true); } }
        KeyBinding { keys: @keys(Home); enabled: !root.address-editing; activated => { root.focus-boundary(false, false); } }
        KeyBinding { keys: @keys(End); enabled: !root.address-editing; activated => { root.focus-boundary(true, false); } }
        KeyBinding { keys: @keys(Shift + Home); enabled: !root.address-editing; activated => { root.focus-boundary(false, true); } }
        KeyBinding { keys: @keys(Shift + End); enabled: !root.address-editing; activated => { root.focus-boundary(true, true); } }
        KeyBinding { keys: @keys(Return); enabled: !root.address-editing; activated => { root.open-entry(-1); } }
        KeyBinding { keys: @keys(Escape); enabled: !root.address-editing; activated => { root.clear-selection(); } }
        KeyBinding { keys: @keys(Control + T); activated => { root.new-tab(); } }
        KeyBinding { keys: @keys(Control + W); enabled: root.can-close-tab; activated => { root.close-tab(-1); } }

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 46px; background: #f5f6f8; border-color: #d9dce2; border-width: 1px;
            HorizontalLayout {
                x: 8px; y: 12px; width: parent.width - 8px - 3 * 46px; height: 34px; spacing: 5px;
                for tab in root.tabs: Rectangle {
                    width: root.minimal ? 112px : 178px; height: 34px;
                    background: tab.active ? #ffffff : (tab-touch.has-hover ? #ebeef4 : transparent);
                    border-color: tab.active ? #d7dae0 : transparent;
                    border-width: tab.active ? 1px : 0px;
                    border-radius: 7px;
                    tab-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.activate-tab(tab.id); }
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.middle && event.kind == PointerEventKind.up && root.can-close-tab) {
                                root.close-tab(tab.id);
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 10px; padding-right: 7px; spacing: 6px;
                        InlineIcon { icon-source: @image-url("icons/files/folder.svg"); icon-size: 16px; }
                        Text { text: tab.title; color: #303138; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        Text { visible: tab.loading && !(root.can-close-tab && tab-touch.has-hover); text: "…"; color: #4f6bed; vertical-alignment: center; }
                        Rectangle {
                            visible: root.can-close-tab && (tab-touch.has-hover || close-touch.has-hover);
                            width: 24px; height: 34px;
                            Rectangle {
                                width: 24px; height: 24px; y: 5px; border-radius: 4px;
                                background: close-touch.pressed ? #d7dae0 : close-touch.has-hover ? #e1e4ea : transparent;
                                Image { width: 12px; height: 12px; x: 6px; y: 6px; source: @image-url("icons/actions/close.svg"); }
                            }
                            close-touch := TouchArea { mouse-cursor: pointer; clicked => { root.close-tab(tab.id); } }
                            accessible-role: button; accessible-label: "关闭标签";
                        }
                    }
                }
                Rectangle { width: 34px; height: 34px; border-radius: 6px; background: add-touch.pressed ? #d9dce2 : add-touch.has-hover ? #e8eaf0 : transparent; Image { width: 20px; height: 20px; x: 9px; y: 9px; source: @image-url("icons/actions/add.svg"); } add-touch := TouchArea { mouse-cursor: pointer; clicked => { root.new-tab(); } } accessible-role: button; accessible-label: "新建标签"; Tooltip { text: @markdown("新建标签 (Ctrl+T)"); } }
                Rectangle {
                    horizontal-stretch: 1;
                    drag-touch := TouchArea {
                        pointer-event(event) => { if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { root.drag-window(); } }
                        double-clicked => { root.maximized = !root.maximized; }
                    }
                }
            }
            HorizontalLayout {
                x: parent.width - 3 * 46px; y: 0px; width: 3 * 46px; height: 40px; spacing: 0px;
                WindowButton { kind: 0; label: "最小化"; clicked => { root.minimized = true; } }
                WindowButton { kind: 1; label: root.maximized ? "还原" : "最大化"; clicked => { root.maximized = !root.maximized; } }
                WindowButton { kind: 2; label: "关闭"; clicked => { root.close(); } }
            }
        }

        Rectangle {
            height: 56px; background: #fafbfc; border-color: #e2e4e9; border-width: 1px;
            HorizontalLayout {
                padding-top: 9px; padding-bottom: 9px; padding-left: 14px; padding-right: 14px; spacing: 7px;
                ContextMenuArea { width: 38px; height: 38px; IconButton { icon-source: @image-url("icons/actions/back.svg"); tip: root.text-back + " (Alt+Left)"; enabled: root.can-navigate-back; button-label: root.text-back; clicked => { root.navigate-back(); } } Menu { for history in root.back-history: MenuItem { title: history.label; activated => { root.navigate-history(true, history.index); } } } }
                ContextMenuArea { visible: !root.minimal; width: 38px; height: 38px; IconButton { icon-source: @image-url("icons/actions/forward.svg"); tip: root.text-forward + " (Alt+Right)"; enabled: root.can-navigate-forward; button-label: root.text-forward; clicked => { root.navigate-forward(); } } Menu { for history in root.forward-history: MenuItem { title: history.label; activated => { root.navigate-history(false, history.index); } } } }
                IconButton { visible: !root.compact; icon-source: @image-url("icons/actions/up.svg"); tip: root.text-up + " (Alt+Up)"; enabled: root.can-navigate-up; button-label: root.text-up; clicked => { root.navigate-up(); } }
                IconButton { visible: !root.compact; icon-source: @image-url("icons/actions/refresh.svg"); tip: root.text-refresh + " (F5)"; enabled: root.can-refresh; button-label: root.text-refresh; clicked => { root.refresh(); } }
                Rectangle {
                    height: 38px; horizontal-stretch: 1; background: #ffffff; border-color: #d7dae0; border-width: 1px; border-radius: 5px;
                    if !root.address-editing: Rectangle { x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px; HorizontalLayout { padding-left: 8px; padding-right: 8px; padding-top: 3px; padding-bottom: 3px; spacing: 2px; InlineIcon { icon-source: @image-url("icons/files/folder.svg"); icon-size: 16px; } for crumb in root.breadcrumbs: BreadcrumbButton { label: crumb.label; current: crumb.current; clicked => { root.navigate-breadcrumb(crumb.index); } } Rectangle { horizontal-stretch: 1; TouchArea { mouse-cursor: pointer; clicked => { root.begin-address-edit(); } } } } }
                    address-editor := AddressEditor { visible: root.address-editing; x: 4px; y: 2px; width: parent.width - 8px; height: parent.height - 4px; text <=> root.address-input; accepted(value) => { root.navigate-path(value); } cancelled => { root.cancel-address-edit(); } }

                }
                IconButton { visible: !root.minimal; icon-source: @image-url("icons/actions/forward.svg"); tip: root.text-go; button-label: root.text-go; clicked => { root.address-editing ? root.navigate-path(root.address-input) : root.begin-address-edit(); } }
            }
        }

        HorizontalLayout {
            spacing: 0px;
            if !root.minimal: Rectangle {
                width: root.compact ? 184px : 218px; background: #f1f2f5; border-color: #e2e3e7; border-width: 1px;
                VerticalLayout {
                    padding-top: 4px; padding-bottom: 12px; padding-left: 10px; padding-right: 10px; spacing: 0px;
                    SidebarGroupHeader { label: root.text-quick-access; expanded: root.quick-access-expanded; toggled => { root.quick-access-expanded = !root.quick-access-expanded; } }
                    for location in root.sidebar-items: Rectangle {
                        visible: !location.is-drive && root.quick-access-expanded;
                        height: self.visible ? 34px : 0px; border-radius: 5px; background: location.selected ? #dce6ff : (side-touch.has-hover ? #e5e9f2 : transparent); border-color: location.selected ? #4f6bed : transparent; border-width: location.selected ? 2px : 0px;
                        HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 10px; InlineIcon { icon-source: location.icon-kind == 0 ? @image-url("icons/locations/home.svg") : location.icon-kind == 1 ? @image-url("icons/locations/desktop.svg") : location.icon-kind == 2 ? @image-url("icons/locations/downloads.svg") : location.icon-kind == 3 ? @image-url("icons/locations/documents.svg") : location.icon-kind == 4 ? @image-url("icons/locations/pictures.svg") : location.icon-kind == 5 ? @image-url("icons/locations/music.svg") : @image-url("icons/locations/video.svg"); } Text { text: location.label; color: #4f535d; font-size: 13px; vertical-alignment: center; overflow: elide; } }
                        side-touch := TouchArea { mouse-cursor: pointer; clicked => { root.navigate-sidebar(location.index); } }
                        accessible-role: button; accessible-label: location.label;
                    }
                    SidebarGroupHeader { label: root.text-drives; expanded: root.drives-expanded; toggled => { root.drives-expanded = !root.drives-expanded; } }
                    for location in root.sidebar-items: Rectangle {
                        visible: location.is-drive && root.drives-expanded;
                        height: self.visible ? 34px : 0px; border-radius: 5px; background: location.selected ? #dce6ff : (drive-touch.has-hover ? #e5e9f2 : transparent); border-color: location.selected ? #4f6bed : transparent; border-width: location.selected ? 2px : 0px;
                        HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 10px; InlineIcon { icon-source: @image-url("icons/locations/drive.svg"); } Text { text: location.label; color: #4f535d; font-size: 13px; vertical-alignment: center; overflow: elide; } }
                        drive-touch := TouchArea { mouse-cursor: pointer; clicked => { root.navigate-sidebar(location.index); } }
                        accessible-role: button; accessible-label: location.label;
                    }
                    Rectangle { vertical-stretch: 1; }
                    Rectangle {
                        width: 38px; height: 38px; border-radius: 5px;
                        background: language-touch.pressed ? #d7dce5 : language-touch.has-hover ? #e3e7ef : transparent;
                        Image { width: 20px; height: 20px; x: 9px; y: 9px; source: @image-url("icons/actions/language.svg"); }
                        language-touch := TouchArea { mouse-cursor: pointer; clicked => { root.toggle-language(); } }
                        accessible-role: button; accessible-label: "切换语言";
                        Tooltip { text: @markdown("切换语言"); }
                    }
                }
            }

            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: 38px; background: #ffffff; border-color: #e7e8eb; border-width: 1px;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px; spacing: 12px;
                        for column in root.columns: Rectangle {
                            visible: column.kind == 0 || (column.kind == 2 && !root.minimal) || ((column.kind == 1 || column.kind == 3) && !root.compact);
                            width: column.kind == 0 ? (root.compact ? 65% : 52%) : column.kind == 1 ? 16% : column.kind == 2 ? (root.compact ? 35% : 14%) : 18%;
                            horizontal-stretch: column.kind == 3 ? 1 : 0;
                            opacity: column-touch.dragging ? 0.58 : 1;
                            Text {
                                x: column.kind == 0 ? 27px : 0px;
                                width: parent.width - self.x;
                                horizontal-alignment: left;
                                text: (column.kind == 0 ? root.text-name : column.kind == 1 ? root.text-type : column.kind == 2 ? root.text-size : root.text-modified) + (root.sort-field == column.kind ? (root.sort-descending ? " ↓" : " ↑") : "");
                                color: root.sort-field == column.kind ? #3b4f83 : #696b74;
                                font-size: 12px; font-weight: root.sort-field == column.kind ? 600 : 400; vertical-alignment: center;
                            }
                            column-touch := TouchArea {
                                private property <length> press-x;
                                property <bool> dragging: false;
                                mouse-cursor: self.dragging ? grabbing : grab;
                                pointer-event(event) => {
                                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                        self.press-x = self.mouse-x;
                                        self.dragging = false;
                                    }
                                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && self.dragging {
                                        root.reorder-column(column.kind, self.mouse-x - self.press-x < -2 * parent.width ? -3 : self.mouse-x - self.press-x < -parent.width ? -2 : self.mouse-x - self.press-x < -8px ? -1 : self.mouse-x - self.press-x > 2 * parent.width ? 3 : self.mouse-x - self.press-x > parent.width ? 2 : 1);
                                    }
                                }
                                moved => { if self.pressed && abs(self.mouse-x - self.press-x) > 8px { self.dragging = true; } }
                                clicked => { if !self.dragging { root.change-sort(column.kind); } }
                            }
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1; background: #ffffff;
                    background-touch := TouchArea { enabled: root.files.length > 0; clicked => { root.clear-selection(); } }
                    list := ListView {
                        visible: root.files.length > 0;
                        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                        for entry in root.files: Rectangle {
                            width: list.width;
                            height: 40px; background: entry.selected ? #dce6ff : (mouse.has-hover ? #eff4ff : #ffffff); border-color: entry.focused ? #4f6bed : #f1f1f3; border-width: entry.focused ? 2px : 1px;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px; spacing: 12px;
                                for column in root.columns: HorizontalLayout {
                                    visible: column.kind == 0 || (column.kind == 2 && !root.minimal) || ((column.kind == 1 || column.kind == 3) && !root.compact);
                                    width: column.kind == 0 ? (root.compact ? 65% : 52%) : column.kind == 1 ? 16% : column.kind == 2 ? (root.compact ? 35% : 14%) : 18%;
                            horizontal-stretch: column.kind == 3 ? 1 : 0;
                                    spacing: column.kind == 0 ? 9px : 0px;
                                    InlineIcon { visible: column.kind == 0; icon-source: entry.is-directory ? @image-url("icons/files/folder.svg") : @image-url("icons/files/document.svg"); }
                                    Text { text: column.kind == 0 ? entry.name : column.kind == 1 ? entry.kind : column.kind == 2 ? entry.size : entry.modified; color: column.kind == 0 ? #24252a : #6f717a; font-size: column.kind == 0 ? 13px : 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; horizontal-alignment: column.kind == 2 ? right : left; }
                                }
                            }
                            mouse := TouchArea {
                                private property <bool> click-control: false;
                                private property <bool> click-shift: false;
                                mouse-cursor: pointer;
                                pointer-event(event) => {
                                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                        self.click-control = event.modifiers.control;
                                        self.click-shift = event.modifiers.shift;
                                    }
                                }
                                clicked => { root.activate-entry(entry.id, self.click-control, self.click-shift); }
                            }
                            accessible-role: list-item; accessible-label: entry.name;
                        }
                    }
                    LightScrollBar {
                        x: parent.width - self.width;
                        height: parent.height;
                        value <=> list.viewport-y;
                        maximum: max(0px, list.viewport-height - list.visible-height);
                        page-size: list.visible-height;
                    }
                    if root.page-state == 1 || root.page-state == 3: VerticalLayout {
                        alignment: center; spacing: 8px;
                        Text { text: root.page-state == 1 ? "正在加载…" : "此文件夹为空"; color: #62656f; font-size: 16px; horizontal-alignment: center; }
                    }
                    if root.page-state >= 5: VerticalLayout {
                        alignment: center; spacing: 12px;
                        HorizontalLayout { alignment: center; Image { width: 48px; height: 48px; source: @image-url("icons/status/lock-closed.svg"); } }
                        Text { text: root.error-page-title; color: #30333a; font-size: 20px; font-weight: 600; horizontal-alignment: center; }
                        Text { text: root.error-page-description; color: #62656f; font-size: 13px; horizontal-alignment: center; }
                        Rectangle { height: 4px; }
                        error-page-actions := Rectangle {
                            height: 32px;
                            accessible-role: groupbox;
                            accessible-id: "error-page-actions";
                            HorizontalLayout {
                                alignment: center; spacing: 8px;
                                if root.show-request-access: CommandButton { width: 196px; icon-source: @image-url("icons/status/lock-closed.svg"); label: root.text-request-access; clicked => { root.request-folder-access(); } }
                            }
                        }
                    }

                }

                Rectangle { height: 30px; background: #fafbfc; border-color: #e7e8eb; border-width: 1px; Text { x: 14px; text: root.status-text; color: #72747d; font-size: 11px; vertical-alignment: center; } }
            }
        }
    }

    if root.address-editing: Rectangle {
        y: 0px;
        width: parent.width;
        height: 59px;
        TouchArea { clicked => { root.cancel-address-edit(); } }
    }
    if root.address-editing: Rectangle {
        x: 0px;
        y: 59px;
        width: 59px + (!root.minimal ? 45px : 0px) + (!root.compact ? 90px : 0px);
        height: 38px;
        TouchArea { clicked => { root.cancel-address-edit(); } }
    }
    if root.address-editing: Rectangle {
        x: parent.width - 59px - (!root.minimal ? 45px : 0px);
        y: 59px;
        width: 59px + (!root.minimal ? 45px : 0px);
        height: 38px;
        TouchArea { clicked => { root.cancel-address-edit(); } }
    }
    if root.address-editing: Rectangle {
        y: 97px;
        width: parent.width;
        height: parent.height - self.y;
        TouchArea { clicked => { root.cancel-address-edit(); } }
    }
    }
}
