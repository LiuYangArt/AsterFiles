                        width: root.rectangle-selection-width;
                        height: root.rectangle-selection-height;
                        z: 90;
                        background: VisualStyle.rectangle-selection-fill;
                        border-color: VisualStyle.rectangle-selection-border;
                        border-width: 1px;
                    }
                    LightScrollBar {
                        x: parent.width - self.width - 9px;
                        height: parent.height;
                        value: root.search-results-mode ? root.search-scroll-y : root.file-viewport-y;
                        maximum: root.search-results-mode
                            ? root.search-scroll-maximum(root.is-grid-view-mode(root.view-mode) ? grid.visible-height : list.visible-height)
                            : (root.is-grid-view-mode(root.view-mode) ? max(0px, grid.viewport-height - grid.visible-height) : max(0px, list.viewport-height - list.visible-height));
                        page-size: root.is-grid-view-mode(root.view-mode) ? grid.visible-height : list.visible-height;
                        scrolled(viewport-y) => {
                            if root.search-results-mode {
                                root.request-search-position(viewport-y / 1px);
                            } else {
                                root.file-viewport-y = viewport-y;
                            }
                        }
                    }
                    if root.page-state == 1 || root.page-state == 3: VerticalLayout {
                        alignment: center; spacing: 8px;
                        Text { text: root.page-state == 1 ? root.text-loading : (root.search-results-mode ? root.text-no-search-results : root.text-empty-folder); color: VisualStyle.c62656f; font-size: 16px; horizontal-alignment: center; }
                    }
                    if root.page-state >= 5: VerticalLayout {
                        alignment: center; spacing: 12px;
                        HorizontalLayout { alignment: center; Image { width: 48px; height: 48px; source: IconMap.status-locked; } }
                        Text { text: root.error-page-title; color: VisualStyle.c30333a; font-size: 20px; font-weight: 600; horizontal-alignment: center; }
                        Text { text: root.error-page-description; color: VisualStyle.c62656f; font-size: 13px; horizontal-alignment: center; }
                        Rectangle { height: 4px; }
                        error-page-actions := Rectangle {
                            height: 32px;
                            accessible-role: groupbox;
                            accessible-id: "error-page-actions";
                            HorizontalLayout {
                                alignment: center; spacing: 8px;
                                if root.show-request-access: StandaloneActionButton { width: 260px; center-content: false; icon-source: IconMap.status-locked; label: root.text-request-access; clicked => { root.request-folder-access(); } }
                            }
                        }
                    }

                }

                Rectangle {
                    height: 30px; background: VisualStyle.cfafbfc;
                    Text { x: 14px; text: root.operation-error != "" && root.rename-editing ? root.operation-error : root.status-text; color: root.operation-error != "" && root.rename-editing ? VisualStyle.cc42b1c : VisualStyle.c72747d; font-size: 11px; vertical-alignment: center; }
                    Rectangle {
                        x: parent.width - 220px; width: 84px; height: 26px; y: 2px;
                        HorizontalLayout {
                            spacing: 2px;
                            for mode in [0, 1, 2]: Rectangle {
                                width: 26px; border-radius: 4px; background: root.view-mode == mode ? VisualStyle.cdce6ff : mode-touch.has-hover ? VisualStyle.ceff4ff : transparent;
                                Text { text: mode == 0 ? "≡" : mode == 1 ? "☷" : "▦"; color: VisualStyle.c30333a; horizontal-alignment: center; vertical-alignment: center; }
                                mode-touch := TouchArea { clicked => { root.change-view-mode(mode); } mouse-cursor: pointer; }
                            }
                        }
                    }
                    Rectangle {
                        visible: root.operations.length > 0;
                        x: parent.width - 126px; width: 118px; height: 26px; y: 2px; border-radius: 5px;
                        background: task-touch.has-hover ? VisualStyle.cedf1f6 : transparent;
                        Text { text: root.operations.length + " " + root.text-task-count; color: VisualStyle.c30333a; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                        task-touch := TouchArea { clicked => { root.open-operation-window(); } mouse-cursor: pointer; }
                        accessible-role: button; accessible-label: "File operations";
                    }
                }
            }
        }

        if root.active-is-settings: Rectangle {
            vertical-stretch: 1;
            background: VisualStyle.c323437;
            HorizontalLayout {
                padding-left: root.minimal ? 16px : 28px;
                padding-right: root.minimal ? 16px : 28px;
                padding-top: 24px;
                padding-bottom: 24px;
                spacing: root.minimal ? 16px : 28px;
                Rectangle {
                    width: root.minimal ? 150px : 236px;
                    background: VisualStyle.cfafbfc;
                    border-radius: 9px;
                    VerticalLayout {
                        padding-left: 12px; padding-right: 12px; padding-top: 18px; padding-bottom: 18px; spacing: 6px;
                        Text { text: root.text-settings-title; color: VisualStyle.c30333a; font-size: 22px; font-weight: 600; height: 42px; }
                        for section[index] in [root.text-settings-general, root.text-settings-appearance, root.text-everything, root.text-settings-developer, root.text-settings-about]: Rectangle {
                            visible: index != 3 || root.debug-tools-enabled;
                            height: 42px; border-radius: 6px;
                            background: root.settings-section == index ? VisualStyle.cdce6ff : (settings-nav-touch.has-hover ? VisualStyle.cedf1f6 : transparent);
                            Rectangle { visible: root.settings-section == index; x: 0px; y: 9px; width: 3px; height: 24px; border-radius: 2px; background: VisualStyle.c4f6bed; }
                            HorizontalLayout {
                                padding-left: 13px; padding-right: 10px; spacing: 10px;
                                InlineIcon { icon-source: index == 0 ? IconMap.action-language : IconMap.action-settings; icon-size: 18px; }
                                Text { text: section; color: VisualStyle.c30333a; font-size: 14px; vertical-alignment: center; overflow: elide; }
                            }
                            settings-nav-touch := TouchArea { mouse-cursor: pointer; clicked => { root.settings-section = index; } }
                            accessible-role: button; accessible-label: section;
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    background: VisualStyle.c323437;
                    settings-scroll := Flickable {
                        width: parent.width; height: parent.height;
                        viewport-width: self.width;
                        viewport-height: max(self.height, 188px);
                        VerticalLayout {
                            width: settings-scroll.width;
                            height: settings-scroll.viewport-height;
                            spacing: 16px;
                            Text { text: root.settings-title(root.settings-section); color: VisualStyle.c30333a; font-size: 22px; font-weight: 600; height: 44px; }
                            if root.settings-section == 0: Rectangle {
                                height: 202px; border-radius: 8px; border-width: 1px; border-color: VisualStyle.ce0e2e7; background: VisualStyle.cfafbfc;
                                VerticalLayout {
                                    padding-left: 20px; padding-right: 20px; padding-top: 16px; padding-bottom: 16px; spacing: 12px;
                                    Text { text: root.text-language; color: VisualStyle.c30333a; font-size: 15px; font-weight: 600; }
                                    HorizontalLayout {
                                        height: 42px; spacing: 8px;
                                        for language-option[index] in [root.text-language-chinese, root.text-language-english]: Rectangle {
                                            horizontal-stretch: 1; border-radius: 6px; border-width: root.language-mode == index ? 2px : 1px;
                                            border-color: root.language-mode == index ? VisualStyle.c4f6bed : VisualStyle.ce0e2e7;
                                            background: language-card-touch.pressed ? VisualStyle.cdde3ed : language-card-touch.has-hover ? VisualStyle.cedf1f6 : VisualStyle.cffffff;
                                            Text { text: language-option; color: VisualStyle.c30333a; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                                            language-card-touch := TouchArea { mouse-cursor: pointer; clicked => { root.change-language(index); } }
                                            accessible-role: button; accessible-label: language-option;
                                        }
                                    }
                                    CheckBox { text: root.text-show-hidden-files; checked: root.show-hidden-files; toggled => { root.change-file-visibility(self.checked, root.show-system-files); } }
                                    CheckBox { text: root.text-show-system-files; checked: root.show-system-files; toggled => { root.change-file-visibility(root.show-hidden-files, self.checked); } }
                                }
                            }
                            if root.settings-section == 1: Rectangle {
                                height: 112px; border-radius: 8px; border-width: 1px; border-color: VisualStyle.ce0e2e7; background: VisualStyle.cfafbfc;
                                VerticalLayout {
                                    padding-left: 20px; padding-right: 20px; padding-top: 16px; padding-bottom: 16px; spacing: 12px;
                                    Text { text: root.text-theme; color: VisualStyle.c30333a; font-size: 15px; font-weight: 600; }
                                    HorizontalLayout {
                                        height: 42px; spacing: 8px;
                                        for theme-option[index] in [root.text-theme-system, root.text-theme-light, root.text-theme-dark]: Rectangle {
                                            horizontal-stretch: 1; border-radius: 6px; border-width: root.theme-mode == index ? 2px : 1px;
                                            border-color: root.theme-mode == index ? VisualStyle.c4f6bed : VisualStyle.ce0e2e7;
                                            background: theme-card-touch.pressed ? VisualStyle.cdde3ed : theme-card-touch.has-hover ? VisualStyle.cedf1f6 : VisualStyle.cffffff;
                                            Text { text: theme-option; color: VisualStyle.c30333a; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                                            theme-card-touch := TouchArea { mouse-cursor: pointer; clicked => { root.change-theme(index); } }
                                            accessible-role: button; accessible-label: theme-option;
                                        }
                                    }
                                }
                            }
                            if root.settings-section == 2: Rectangle {
                                height: 262px; border-radius: 8px; border-width: 1px; border-color: VisualStyle.ce0e2e7; background: VisualStyle.cfafbfc;
                                VerticalLayout {
                                    padding-left: 20px; padding-right: 20px; padding-top: 16px; padding-bottom: 16px; spacing: 10px;
                                    Text { text: root.text-everything-path; color: VisualStyle.c30333a; font-size: 13px; }
                                    Rectangle { height: 34px; border-width: 1px; border-color: VisualStyle.ce0e2e7; background: VisualStyle.cffffff; TextInput { x: 8px; width: parent.width - 16px; height: parent.height; text <=> root.everything-path; single-line: true; edited => { root.update-everything-config(root.everything-path, root.everything-instance); } } }
                                    Text { text: root.text-everything-instance; color: VisualStyle.c30333a; font-size: 13px; }
                                    Rectangle { height: 34px; border-width: 1px; border-color: VisualStyle.ce0e2e7; background: VisualStyle.cffffff; TextInput { x: 8px; width: parent.width - 16px; height: parent.height; text <=> root.everything-instance; single-line: true; edited => { root.update-everything-config(root.everything-path, root.everything-instance); } } }
                                    Text { text: root.everything-status; color: VisualStyle.c62656f; font-size: 12px; wrap: word-wrap; }
                                    HorizontalLayout { height: 34px; spacing: 8px; StandaloneActionButton { width: (parent.width - 8px) / 2; label: root.text-test-connection; clicked => { root.test-everything-connection(); } } StandaloneActionButton { width: (parent.width - 8px) / 2; label: root.text-start-everything; clicked => { root.start-everything(); } } }
                                }
                            }                            if root.settings-section == 3 && root.debug-tools-enabled: VerticalLayout {
                                spacing: 12px;
                                Rectangle {
                                    height: 244px; border-radius: 8px; border-width: 1px; border-color: VisualStyle.ce0e2e7; background: VisualStyle.cfafbfc;
                                    VerticalLayout {
                                        padding-left: 20px; padding-right: 20px; padding-top: 16px; padding-bottom: 16px; spacing: 12px;
                                        Text { text: root.text-ui-showcase; color: VisualStyle.c30333a; font-size: 15px; font-weight: 600; }
                                        Text { text: root.text-ui-showcase-detail; color: VisualStyle.c62656f; font-size: 12px; wrap: word-wrap; }
                                        HorizontalLayout {
                                            height: 34px; spacing: 8px;
                                            StandaloneActionButton { width: (parent.width - 8px) / 2; label: root.text-show-delete-confirmation; clicked => { root.show-debug-window(0); } }
                                            StandaloneActionButton { width: (parent.width - 8px) / 2; label: root.text-show-conflict-confirmation; clicked => { root.show-debug-window(1); } }
                                        }
                                        HorizontalLayout {
                                            height: 34px; spacing: 8px;
                                            StandaloneActionButton { width: (parent.width - 8px) / 2; label: root.text-show-exit-confirmation; clicked => { root.show-debug-window(2); } }
                                            StandaloneActionButton { width: (parent.width - 8px) / 2; label: root.text-show-operation-window; clicked => { root.show-debug-window(3); } }
                                        }
                                    }
                                }
                                Rectangle {
                                    height: 170px; border-radius: 8px; border-width: 1px; border-color: VisualStyle.ce0e2e7; background: VisualStyle.cfafbfc;
                                    VerticalLayout {
                                        padding-left: 20px; padding-right: 20px; padding-top: 16px; padding-bottom: 16px; spacing: 10px;
                                        Text { text: root.text-window-trace-title; color: VisualStyle.c30333a; font-size: 15px; font-weight: 600; }
                                        Text { text: root.text-window-trace-detail; color: VisualStyle.c62656f; font-size: 12px; wrap: word-wrap; }
                                        HorizontalLayout {
                                            height: 34px; spacing: 12px;
                                            StandaloneActionButton { width: 132px; enabled: !root.window-trace-active; label: root.window-trace-active ? root.text-window-trace-active : root.text-window-trace-start; clicked => { root.start-window-trace(); } }
                                            Text { text: root.window-trace-status; color: root.window-trace-active ? VisualStyle.c4f6bed : VisualStyle.c62656f; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                        }
                                    }
                                }
                            }
                            if root.settings-section == 4: Rectangle {
                                height: 144px; border-radius: 8px; border-width: 1px; border-color: VisualStyle.ce0e2e7; background: VisualStyle.cfafbfc;
                                VerticalLayout {
                                    padding-left: 20px; padding-right: 20px; padding-top: 20px; padding-bottom: 20px; spacing: 10px;
                                    Text { text: "AsterFiles"; color: VisualStyle.c30333a; font-size: 20px; font-weight: 600; }
                                    Text { text: root.text-version + " " + root.app-version; color: VisualStyle.c62656f; font-size: 14px; }
                                    Text { text: "GNU General Public License v3.0"; color: VisualStyle.c62656f; font-size: 12px; }
                                }
                            }
                            Rectangle { height: 16px; }
                        }
                    }
                }
            }
        }
    }

    if root.column-dragging: Rectangle {
        x: max(4px, min(root.width - self.width - 4px, root.column-drag-pointer-x + 12px));
        y: max(50px, min(root.height - self.height - 4px, root.column-drag-pointer-y + 10px));
        width: min(220px, max(84px, root.column-width(root.column-drag-source-kind)));
        height: 32px; z: 100; border-radius: 5px; border-width: 1px;
        border-color: VisualStyle.ce0e2e7; background: VisualStyle.cffffff; opacity: 0.82;
        Text { x: 10px; width: parent.width - 20px; text: root.column-label(root.column-drag-source-kind); color: VisualStyle.c30333a; font-size: 12px; vertical-alignment: center; overflow: elide; }
    }

    if root.drop-menu-open: TouchArea {
        z: 38; width: parent.width; height: parent.height;
        clicked => { root.drop-menu-open = false; root.choose-drop-effect(0); }
    }
    if root.drop-menu-open: Rectangle {
        z: 39;
        x: min(max(12px, root.context-menu-anchor-x), max(12px, parent.width - self.width - 12px));
        y: min(max(12px, root.context-menu-anchor-y), max(12px, parent.height - self.height - 12px));
        width: 250px; height: 156px;
        background: VisualStyle.cffffff; border-color: VisualStyle.ce0e2e7; border-width: 1px; border-radius: 7px;
        VerticalLayout { padding: 6px;
            for option[index] in [root.text-drop-copy, root.text-drop-move, root.text-drop-link, root.text-drop-cancel]: Rectangle {
                height: 36px; border-radius: 5px;
                private property <bool> option-enabled: index == 3 || (index == 0 ? root.drop-can-copy : index == 1 ? root.drop-can-move : root.drop-can-link);
                background: self.option-enabled && option-touch.has-hover ? VisualStyle.cedf1f6 : transparent;
                Text { x: 10px; text: option; color: parent.option-enabled ? VisualStyle.c30333a : VisualStyle.c9a9da3; font-size: 12px; vertical-alignment: center; }
                option-touch := TouchArea { enabled: parent.option-enabled; clicked => { root.drop-menu-open = false; root.choose-drop-effect(index == 3 ? 0 : index + 1); } }
                accessible-role: button; accessible-label: option; accessible-enabled: self.option-enabled;
            }
        }
    }
    if root.rename-editing: TouchArea {
        z: 100;
        width: parent.width;
        height: parent.height;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left && !root.rename-submitting {
                root.rename-submitting = true;
                root.commit-rename(root.rename-input);
            }
        }
    }

if root.tabs-menu-open: TouchArea {
        z: 19;
        width: parent.width;
        height: parent.height;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.dismiss-menus-and-drag-window(
                    self.absolute-position.x + self.mouse-x - root.absolute-position.x,
                    self.absolute-position.y + self.mouse-y - root.absolute-position.y
                );
            }
        }
        clicked => { root.tabs-menu-open = false; }
    }

    if root.tabs-menu-open: Rectangle {
        x: max(8px, parent.width - 3 * 46px - 270px); y: 46px;
        width: 260px; height: min(354px, 12px + min(root.tabs.length, 9) * 38px); z: 20;
        background: VisualStyle.cffffff; border-color: VisualStyle.ce0e2e7; border-width: 1px; border-radius: 7px;
        clip: true;
        ListView {
            x: 6px; y: 6px; width: parent.width - 12px; height: parent.height - 12px;
            vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
            for tab[index] in root.tabs: Rectangle {
                height: 38px; border-radius: 5px;
                background: tab.active ? VisualStyle.cdce6ff : (tabs-menu-touch.has-hover ? VisualStyle.cedf1f6 : transparent);
                HorizontalLayout {
                    padding-left: 8px; padding-right: 8px; spacing: 8px;
                    InlineIcon { icon-source: tab.is-settings ? IconMap.action-settings : (tab.icon.width != 0 ? tab.icon : (tab.is-drive ? IconMap.location-drive : IconMap.file-folder)); icon-size: 16px; }
                    Text { text: tab.title; color: VisualStyle.c303138; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; font-weight: tab.active ? 600 : 400; }
                }
                tabs-menu-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.tabs-menu-open = false; root.activate-tab(tab.id); root.reveal-tab(index); }
                }
                accessible-role: button; accessible-label: tab.title;
            }
        }
    }
    if root.menu-open: TouchArea {
        z: 19;
        width: parent.width;
        height: parent.height;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.dismiss-menus-and-drag-window(
                    self.absolute-position.x + self.mouse-x - root.absolute-position.x,
                    self.absolute-position.y + self.mouse-y - root.absolute-position.y
                );
            }
        }
        clicked => { root.menu-open = false; }
    }

    if root.menu-open: Rectangle {
        x: 8px; y: 46px; width: 190px; height: 54px; z: 20;
        background: VisualStyle.cffffff; border-color: VisualStyle.ce0e2e7; border-width: 1px; border-radius: 7px;
        Rectangle {
            x: 6px; y: 6px; width: parent.width - 12px; height: 42px; border-radius: 5px;
            background: settings-menu-touch.pressed ? VisualStyle.cdde3ed : settings-menu-touch.has-hover ? VisualStyle.cedf1f6 : transparent;
            HorizontalLayout {
                padding-left: 10px; padding-right: 10px; spacing: 10px;
                Rectangle {
                    width: 18px; height: parent.height;
                    Image {
                        width: 18px; height: 18px;
                        y: (parent.height - self.height) / 2;
                        source: IconMap.action-settings;
                        colorize: VisualStyle.c303138;
                    }
                }
                Text { text: root.text-settings; color: VisualStyle.c30333a; font-size: 13px; vertical-alignment: center; }
            }
            settings-menu-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.menu-open = false; root.open-settings(); }
            }
            accessible-role: button; accessible-label: root.text-settings;
        }
    }


    }
}
