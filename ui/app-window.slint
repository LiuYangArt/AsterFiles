import { Button, LineEdit, ListView } from "std-widgets.slint";

export struct FileRow {
    id: int,
    name: string,
    kind: string,
    size: string,
    modified: string,
    is-directory: bool,
}

export struct TabRow {
    id: int,
    title: string,
    active: bool,
    loading: bool,
}

component IconButton inherits Button {
    in property <image> icon-source;
    icon: root.icon-source;
    text: "";
    width: 38px;
    height: 38px;
}

component InlineIcon inherits Rectangle {
    in property <image> icon-source;
    in property <length> icon-size: 18px;
    width: root.icon-size;
    Image {
        width: root.icon-size;
        height: root.icon-size;
        y: (parent.height - self.height) / 2;
        source: root.icon-source;
    }
}
component SidebarItem inherits Rectangle {
    in property <image> icon-source;
    in property <string> label;
    height: 34px;
    border-radius: 5px;
    background: item-mouse.has-hover ? #e5e9f2 : transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        InlineIcon { icon-source: root.icon-source; }
        Text { text: root.label; color: #4f535d; font-size: 13px; vertical-alignment: center; }
    }
    item-mouse := TouchArea { mouse-cursor: pointer; }
}

export component AppWindow inherits Window {
    title: "AsterFiles";
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 820px;
    min-height: 520px;
    background: #f5f6f8;
    default-font-family: "Segoe UI";

    in-out property <string> current-path: "C:\\";
    in property <string> status-text: "";
    in property <[FileRow]> files;
    in property <[TabRow]> tabs;
    in property <bool> can-navigate-back: false;
    in property <bool> can-navigate-forward: false;
    in property <bool> can-navigate-up: false;
    in property <bool> can-refresh: false;
    in property <bool> can-close-tab: false;
    in property <bool> can-restore-tab: false;
    in property <string> language-label: "EN";
    in property <string> text-go: "前往";
    in property <string> text-back: "后退";
    in property <string> text-forward: "前进";
    in property <string> text-up: "向上";
    in property <string> text-refresh: "刷新";
    in property <string> text-home: "主页";
    in property <string> text-desktop: "桌面";
    in property <string> text-downloads: "下载";
    in property <string> text-documents: "文档";
    in property <string> text-pictures: "图片";
    in property <string> text-drives: "磁盘";
    in property <string> text-name: "名称";
    in property <string> text-type: "类型";
    in property <string> text-modified: "修改时间";
    in property <string> text-size: "大小";

    callback navigate-path(string);
    callback navigate-back();
    callback navigate-forward();
    callback navigate-up();
    callback refresh();
    callback open-entry(int);
    callback new-tab();
    callback close-tab();
    callback restore-tab();
    callback activate-tab(int);
    callback toggle-language();

    shortcut-handler := FocusScope {
        width: 0px;
        height: 0px;
        KeyBinding { keys: @keys(Alt + LeftArrow); enabled: root.can-navigate-back; activated => { root.navigate-back(); } }
        KeyBinding { keys: @keys(Alt + RightArrow); enabled: root.can-navigate-forward; activated => { root.navigate-forward(); } }
        KeyBinding { keys: @keys(Alt + UpArrow); enabled: root.can-navigate-up; activated => { root.navigate-up(); } }
        KeyBinding { keys: @keys(F5); enabled: root.can-refresh; activated => { root.refresh(); } }
        KeyBinding { keys: @keys(Control + R); enabled: root.can-refresh; activated => { root.refresh(); } }
    }

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 50px;
            background: #ffffff;
            border-color: #e2e4e9;
            border-width: 1px;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 12px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 7px;
                Text { text: "AsterFiles"; width: 112px; color: #1e1f24; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                for tab in root.tabs: Rectangle {
                    width: 170px;
                    background: tab.active ? #eef2ff : #f7f7f8;
                    border-color: tab.active ? #9eaff6 : #e2e3e7;
                    border-width: 1px;
                    border-radius: 7px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 8px;
                        spacing: 6px;
                                        InlineIcon { icon-source: @image-url("icons/files/folder.svg"); icon-size: 16px; }
                        Text { text: tab.title; color: #303138; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        Text { text: tab.loading ? "…" : ""; color: #4f6bed; vertical-alignment: center; }
                    }
                    tab-click := TouchArea { clicked => { root.activate-tab(tab.id); } }
                }
                IconButton { icon-source: @image-url("icons/actions/add.svg"); accessible-label: "New tab"; clicked => { root.new-tab(); } }
                IconButton { icon-source: @image-url("icons/actions/close.svg"); enabled: root.can-close-tab; accessible-label: "Close tab"; clicked => { root.close-tab(); } }
                Button { text: "恢复"; enabled: root.can-restore-tab; clicked => { root.restore-tab(); } }
                Rectangle { horizontal-stretch: 1; }
                Button { text: root.language-label; clicked => { root.toggle-language(); } }
            }
        }

        Rectangle {
            height: 56px;
            background: #fafbfc;
            border-color: #e2e4e9;
            border-width: 1px;
            HorizontalLayout {
                padding-top: 9px;
                padding-bottom: 9px;
                padding-left: 14px;
                padding-right: 14px;
                spacing: 7px;
                IconButton { icon-source: @image-url("icons/actions/back.svg"); enabled: root.can-navigate-back; accessible-label: root.text-back; clicked => { root.navigate-back(); } }
                IconButton { icon-source: @image-url("icons/actions/forward.svg"); enabled: root.can-navigate-forward; accessible-label: root.text-forward; clicked => { root.navigate-forward(); } }
                IconButton { icon-source: @image-url("icons/actions/up.svg"); enabled: root.can-navigate-up; accessible-label: root.text-up; clicked => { root.navigate-up(); } }
                IconButton { icon-source: @image-url("icons/actions/refresh.svg"); enabled: root.can-refresh; accessible-label: root.text-refresh; clicked => { root.refresh(); } }
                Rectangle {
                    height: 38px;
                    horizontal-stretch: 1;
                    background: #ffffff;
                    border-color: #d7dae0;
                    border-width: 1px;
                    border-radius: 5px;
                    TextInput {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        text <=> root.current-path;
                        color: #24252a;
                        selection-background-color: #b9c6ff;
                        selection-foreground-color: #16171a;
                        font-size: 13px;
                        vertical-alignment: center;
                        accepted => { root.navigate-path(self.text); }
                    }
                }
                Button { text: root.text-go; clicked => { root.navigate-path(root.current-path); } }
            }
        }

        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: 218px;
                background: #f1f2f5;
                border-color: #e2e3e7;
                border-width: 1px;
                VerticalLayout {
                    padding-top: 14px;
                    padding-bottom: 14px;
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 3px;
                    Text { text: root.text-home; height: 28px; font-size: 13px; font-weight: 700; color: #2b2c31; vertical-alignment: center; }
                    SidebarItem { icon-source: @image-url("icons/locations/home.svg"); label: root.text-home; }
                    SidebarItem { icon-source: @image-url("icons/locations/desktop.svg"); label: root.text-desktop; }
                    SidebarItem { icon-source: @image-url("icons/locations/downloads.svg"); label: root.text-downloads; }
                    SidebarItem { icon-source: @image-url("icons/locations/documents.svg"); label: root.text-documents; }
                    SidebarItem { icon-source: @image-url("icons/locations/pictures.svg"); label: root.text-pictures; }
                    Rectangle { height: 10px; }
                    Text { text: root.text-drives; height: 28px; font-size: 12px; font-weight: 700; color: #777a84; vertical-alignment: center; }
                    SidebarItem { icon-source: @image-url("icons/locations/drive.svg"); label: "Windows (C:)"; }
                    Rectangle { vertical-stretch: 1; }
                }
            }

            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: 38px;
                    background: #ffffff;
                    border-color: #e7e8eb;
                    border-width: 1px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 12px;
                        Text { text: root.text-name; width: 52%; color: #696b74; font-size: 12px; vertical-alignment: center; }
                        Text { text: root.text-type; width: 16%; color: #696b74; font-size: 12px; vertical-alignment: center; }
                        Text { text: root.text-modified; width: 18%; color: #696b74; font-size: 12px; vertical-alignment: center; }
                        Text { text: root.text-size; horizontal-stretch: 1; color: #696b74; font-size: 12px; vertical-alignment: center; }
                    }
                }

                list := ListView {
                    for entry in root.files: Rectangle {
                        height: 40px;
                        background: mouse.has-hover ? #eff4ff : #ffffff;
                        border-color: #f1f1f3;
                        border-width: 1px;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 12px;
                            HorizontalLayout {
                                width: 52%;
                                spacing: 9px;
                                                        InlineIcon { icon-source: entry.is-directory ? @image-url("icons/files/folder.svg") : @image-url("icons/files/document.svg"); }
                                Text { text: entry.name; color: #24252a; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            }
                            Text { text: entry.kind; width: 16%; color: #6f717a; font-size: 12px; vertical-alignment: center; }
                            Text { text: entry.modified; width: 18%; color: #6f717a; font-size: 12px; vertical-alignment: center; }
                            Text { text: entry.size; horizontal-stretch: 1; color: #6f717a; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                        }
                        mouse := TouchArea { clicked => { if (entry.is-directory) { root.open-entry(entry.id); } } }
                    }
                }

                Rectangle {
                    height: 30px;
                    background: #fafbfc;
                    border-color: #e7e8eb;
                    border-width: 1px;
                    Text { x: 14px; text: root.status-text; color: #72747d; font-size: 11px; vertical-alignment: center; }
                }
            }
        }
    }
}