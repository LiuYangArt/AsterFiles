import { VisualStyle } from "visual-style.slint";
import { ListView } from "std-widgets.slint";
import { OperationRow } from "models.slint";
import { StandaloneActionButton, StandaloneTitleBar } from "action-controls.slint";

export component OperationWindow inherits Window {
    title: root.text-file-operations;
    icon: @image-url("../assets/app-icon.png");
    no-frame: true;
    resize-border-width: 0px;
    preferred-width: 580px;
    preferred-height: max(278px, min(650px, 48px + root.operations.length * 230px));
    min-width: 580px;
    max-width: 580px;
    min-height: 278px;
    max-height: 760px;
    background: VisualStyle.surface;
    default-font-family: "Segoe UI";

    in property <[OperationRow]> operations;
    in property <bool> demo-mode: false;
    in property <string> demo-notice: "";
    in property <bool> dark-theme: false;
    in property <string> text-file-operations: "文件操作";
    in property <string> text-cancel-operation: "取消";
    in property <string> text-retry-operation: "重试";
    in property <string> text-no-operations: "没有文件操作";

    in property <string> text-window-close: "关闭";
    in property <string> text-pause-operation: "暂停";
    in property <string> text-resume-operation: "继续";
    in property <string> text-pausing-operation: "正在暂停";
    in property <string> text-cancelling-operation: "正在取消";

    callback cancel-operation(int);
    callback set-operation-paused(int, bool);
    callback retry-operation(int);

    callback drag-window();

    changed dark-theme => { VisualStyle.dark-theme = root.dark-theme; }

    VerticalLayout {
        StandaloneTitleBar { title: root.text-file-operations; close-label: root.text-window-close; close-requested => { root.close(); } drag-window => { root.drag-window(); } }
        Rectangle {
            vertical-stretch: 1;
            background: VisualStyle.surface;
            if root.operations.length == 0: Text {
                text: root.text-no-operations;
                color: VisualStyle.text-secondary;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if root.demo-mode: Text { x: 20px; y: 8px; width: parent.width - 40px; height: 20px; text: root.demo-notice; color: VisualStyle.text-secondary; font-size: 12px; vertical-alignment: center; overflow: elide; }
            if root.operations.length > 0: ListView {
                y: root.demo-mode ? 34px : 0px;
                width: parent.width;
                height: root.demo-mode ? parent.height - 34px : parent.height;
                for operation[index] in root.operations: Rectangle {
                    height: 230px;
                    background: VisualStyle.surface;
                    accessible-role: groupbox;
                    accessible-id: "operation/" + operation.id;
                    accessible-label: operation.accessible-label;
                    Text { x: 20px; y: 8px; width: parent.width - 40px; height: 22px; text: operation.title; color: VisualStyle.text-primary; font-size: 14px; font-weight: operation.state == 2 ? 700 : 600; overflow: elide; vertical-alignment: center; }
                    Text { x: 20px; y: 30px; width: parent.width - 40px; height: 18px; text: operation.status + (operation.queue != "" ? " · " + operation.queue : ""); color: VisualStyle.text-secondary; font-size: 12px; overflow: elide; vertical-alignment: center; }
                    Text { x: 20px; y: 50px; width: parent.width - 40px; height: 18px; text: operation.source-line; color: VisualStyle.text-secondary; font-size: 11px; overflow: elide; vertical-alignment: center; }
                    Text { x: 20px; y: 68px; width: parent.width - 40px; height: 18px; text: operation.destination-line; color: VisualStyle.text-secondary; font-size: 11px; overflow: elide; vertical-alignment: center; }
                    Text { x: 20px; y: 86px; width: parent.width - 40px; height: 18px; text: operation.failure-summary != "" ? operation.failure-summary : operation.current-item-line; color: operation.failure-summary != "" ? VisualStyle.danger : VisualStyle.text-primary; font-size: 12px; overflow: elide; vertical-alignment: center; }
                    Rectangle {
                        x: 20px;
                        y: 110px;
                        width: parent.width - 40px;
                        height: 22px;
                        border-radius: 11px;
                        background: VisualStyle.border;
                        Rectangle {
                            x: operation.progress-known ? 0px : -parent.width + (parent.width * mod(animation-tick(), 2s) / 1s);
                            width: operation.progress-known ? max(0px, min(parent.width, parent.width * operation.progress)) : parent.width;
                            height: parent.height;
                            border-radius: 11px;
                            background: operation.state == 8 || operation.state == 7 ? #b3261e : VisualStyle.selection;
                        }
                        Text { text: operation.file-progress; color: VisualStyle.text-primary; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        x: 20px;
                        y: 138px;
                        width: parent.width - 40px;
                        height: 20px;
                        spacing: 20px;
                        Text { text: operation.transferred; color: VisualStyle.text-tertiary; font-size: 11px; vertical-alignment: center; }
                        Text { text: operation.speed; color: VisualStyle.text-tertiary; font-size: 11px; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: operation.eta; color: VisualStyle.text-secondary; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        x: parent.width - self.width - 20px;
                        y: 178px;
                        width: 176px;
                        height: 34px;
                        spacing: 8px;
                        StandaloneActionButton { accessible-id: "operation/" + operation.id + "/pause"; visible: operation.can-pause || operation.pause-pending; enabled: !operation.pause-pending; width: 84px; label: operation.pause-pending ? root.text-pausing-operation : operation.paused ? root.text-resume-operation : root.text-pause-operation; clicked => { if (!root.demo-mode) { root.set-operation-paused(operation.id, !operation.paused); } } }
                        StandaloneActionButton { accessible-id: "operation/" + operation.id + "/cancel"; visible: operation.can-cancel || operation.cancel-pending; enabled: operation.can-cancel && !operation.cancel-pending; width: 84px; label: operation.cancel-pending ? root.text-cancelling-operation : root.text-cancel-operation; clicked => { if (!root.demo-mode) { root.cancel-operation(operation.id); } } }
                        StandaloneActionButton { accessible-id: "operation/" + operation.id + "/retry"; visible: operation.can-retry; width: 76px; label: root.text-retry-operation; clicked => { if (!root.demo-mode) { root.retry-operation(operation.id); } } }
                    }
                    Rectangle { visible: index + 1 < root.operations.length; x: 20px; y: parent.height - 1px; width: parent.width - 40px; height: 1px; background: VisualStyle.border; }
                }
            }
        }
    }
}
